<file path="views/partials/loader.ejs">
<div id="globalLoader" class="fixed inset-0 z-[99999] flex flex-col items-center justify-center bg-[#05070a]/85 backdrop-blur-xl transition-opacity duration-300 opacity-0 pointer-events-none">
    <div class="relative flex flex-col items-center scale-90 sm:scale-100">
        <!-- الحاوية المكبّرة للشعار مع تأثير النبض وحلقة الدوران -->
        <div class="relative w-48 h-48 flex items-center justify-center mb-6 z-10">
            <!-- الشعار بحجم كبير ومميز -->
            <img src="/images/logo.png" alt="شعار الكلية" class="w-36 h-36 object-contain animate-pulse drop-shadow-[0_0_35px_rgba(249,115,22,0.6)] z-10">
            <!-- حلقة تدور حول الشعار بحجم متناسق ومكبر -->
            <div class="absolute inset-0 rounded-full border-4 border-transparent border-t-orange-500/80 border-b-orange-500/80 animate-[spin_1.5s_linear_infinite]"></div>
        </div>
        
        <h3 class="text-white font-black tracking-widest text-2xl mb-3">الكلية العسكرية</h3>
        <div class="flex items-center gap-3 bg-[#0e1218]/90 px-6 py-3 rounded-full border border-[#1f2630] shadow-inner">
            <div class="w-5 h-5 border-2 border-orange-500 border-t-transparent rounded-full animate-spin"></div>
            <p class="text-orange-400 font-mono text-sm font-bold tracking-wide">جاري سحب البيانات الآمنة...</p>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const loader = document.getElementById('globalLoader');
        
        function showLoader() {
            loader.classList.remove('opacity-0', 'pointer-events-none');
            loader.classList.add('opacity-100', 'pointer-events-auto');
        }

        function hideLoader() {
            loader.classList.remove('opacity-100', 'pointer-events-auto');
            loader.classList.add('opacity-0', 'pointer-events-none');
        }

        hideLoader();

        window.addEventListener('pageshow', (e) => {
            if (e.persisted) hideLoader();
        });

        document.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', function(e) {
                const href = this.getAttribute('href');
                const target = this.getAttribute('target');
                if (href && href.startsWith('/') && !href.startsWith('#') && target !== '_blank' && !href.includes('logout')) {
                    showLoader();
                }
            });
        });

        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', () => showLoader());
        });
    });
</script>
</file>

<file path="views/applications.ejs">
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>تقديمات الشرطة | الكلية العسكرية</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen flex flex-col selection:bg-orange-500 selection:text-white relative">
    <%- include('partials/navbar') %>

    <main class="max-w-7xl mx-auto px-6 py-10 flex-1 w-full">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-8 border-b border-[#1f2630] pb-5">
            <div>
                <span class="text-orange-500 font-mono text-xs font-bold uppercase tracking-widest">STAGE 01 // NEW APPLICANTS</span>
                <h2 class="text-3xl font-black text-white mt-1">التقديمات (الدورة الثالثة للشرطة)</h2>
            </div>
            <div class="flex items-center gap-3 w-full md:w-auto">
                <input type="text" id="searchInput" onkeyup="filterCards()" placeholder="🔍 ابحث بالاسم أو Copy ID..." class="search-input md:w-80">
                <div class="bg-[#12171f] px-4 py-2.5 rounded-xl border border-[#222b38] text-xs font-bold whitespace-nowrap">
                    جديد: <span id="countDisplay" class="text-orange-400 font-mono"><%= applications.length %></span>
                </div>
            </div>
        </div>

        <div id="cardsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
            <% applications.forEach(app => { %>
                <div class="card-tactical group" data-search="<%= app.name %> <%= app.id %>">
                    <div class="absolute top-0 right-0 w-2 h-full bg-gradient-to-b from-orange-500 to-amber-600"></div>
                    <div>
                        <div class="card-header">
                            <div>
                                <h3 class="card-title"><%= app.name %></h3>
                                <span class="card-id">ID: <%= app.id %></span>
                            </div>
                            <span class="badge badge-new">جديد</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2 my-4 text-xs font-mono bg-[#080a0e]/80 p-3 rounded-xl border border-[#1a2029]">
                            <div class="text-gray-400">👤 العمر: <strong class="text-white"><%= app.age %></strong></div>
                            <div class="text-gray-400">💬 الديسكورد: <strong class="text-white truncate" dir="ltr"><%= app.discordId %></strong></div>
                        </div>
                    </div>
                    <div class="mt-4 pt-4 border-t border-[#1a2029]">
                        <button onclick="openModal('<%= app.id %>')" class="btn btn-view">👁️ استعراض ملف التقديم والإجابات</button>
                    </div>
                </div>
            <% }) %>
        </div>

        <% if(reviewedApps && reviewedApps.length > 0) { %>
            <div class="pt-8 border-t-2 border-[#1f2630]">
                <h3 class="text-xl font-black text-gray-300 mb-6">📁 سجل التقديمات المراجعة (<%= reviewedApps.length %>)</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 opacity-75 hover:opacity-100 transition-opacity">
                    <% reviewedApps.forEach(app => { %>
                        <div class="card-tactical !p-5" data-search="<%= app.name %> <%= app.id %> <%= app.copyId %>">
                            <div class="card-header mb-2">
                                <div>
                                    <h3 class="card-title text-lg"><%= app.name %></h3>
                                    <span class="card-id">ID: <%= app.copyId || app.id %></span>
                                </div>
                                <span class="badge <%= app.status.includes('مقبول') ? 'badge-new !text-emerald-400 !border-emerald-500' : 'badge-rejected' %>">
                                    <%= app.status.includes('مقبول') ? '✔ مقبول' : '✖ مرفوض' %>
                                </span>
                            </div>
                            <div class="mt-3 pt-3 border-t border-white/5 text-xs font-mono <%= app.status.includes('مقبول') ? 'text-emerald-400/90' : 'text-red-400/90' %>">
                                📝 <%= app.gradedBy || '[تمت المراجعة بواسطة القيادة]' %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </main>

    <div id="applicantModal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/80 backdrop-blur-md p-4 sm:p-6 overflow-y-auto">
        <div class="bg-[#0e1218] border border-[#222b38] w-full max-w-4xl rounded-3xl shadow-[0_0_50px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col max-h-[90vh] animate-modal relative">
            <div class="bg-[#12171f] px-6 py-5 border-b border-[#222b38] flex justify-between items-center sticky top-0 z-10">
                <div class="flex items-center gap-3">
                    <span class="w-3 h-3 rounded-full bg-orange-500 animate-pulse"></span>
                    <div>
                        <h3 id="modalName" class="text-xl font-black text-white">اسم المتقدم</h3>
                        <p id="modalId" class="card-id">ID: 000000000</p>
                    </div>
                </div>
                <button onclick="closeModal('applicantModal')" class="w-10 h-10 rounded-xl bg-[#1a2029] hover:bg-red-600/80 text-gray-400 hover:text-white flex items-center justify-center transition font-bold">✕</button>
            </div>
            
            <div class="p-6 overflow-y-auto flex-1 space-y-4">
                <div id="modalQaGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
            </div>

            <% if(user.permissions.canApproveReject || user.permissions.canAcceptApplications) { %>
                <div class="bg-[#12171f] px-6 py-4 border-t border-[#222b38] flex flex-col sm:flex-row gap-3 justify-end items-center sticky bottom-0 z-10">
                    <button id="btnRejectMain" onclick="promptReject()" class="btn btn-reject sm:w-auto px-8 py-2.5">✖ رفض التقديم</button>
                    <button id="btnAcceptMain" onclick="promptAcceptData()" class="btn btn-accept sm:w-auto px-10 py-2.5">✔ قبول واستكمال البيانات</button>
                </div>
            <% } %>
        </div>
    </div>

    <div id="fillDataModal" class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/90 backdrop-blur-md p-4">
        <div class="bg-[#0e1218] border border-emerald-500/40 w-full max-w-md rounded-2xl shadow-2xl p-6 animate-modal">
            <h3 class="text-xl font-black text-white mb-2">📝 استكمال بيانات المرشح</h3>
            <p class="text-xs text-gray-400 mb-6">يرجى التأكد من تعبئة الرقم الوطني للمتقدم قبل نقله للمقابلة.</p>
            
            <div class="space-y-4">
                <div>
                    <label class="text-xs font-bold text-gray-300">الرقم الوطني: <span class="text-red-500">*</span></label>
                    <input type="text" id="fillNationalId" class="search-input mt-1 w-full" placeholder="أدخل الرقم الوطني للمتقدم">
                </div>
                <div id="ageContainer" style="display: none;">
                    <label class="text-xs font-bold text-gray-300">العمر: <span class="text-red-500">*</span> <span class="text-[10px] text-gray-500">(غير متوفر في التقديم)</span></label>
                    <input type="number" id="fillAge" class="search-input mt-1 w-full" placeholder="أدخل العمر الحقيقي">
                </div>
            </div>

            <div class="flex gap-3 mt-8">
                <button onclick="closeModal('fillDataModal')" class="btn bg-[#1a2029] text-gray-400 hover:text-white border border-[#222b38]">إلغاء</button>
                <button onclick="confirmAcceptSubmit()" class="btn btn-accept" id="finalAcceptBtn">✔ تأكيد واعتماد</button>
            </div>
        </div>
    </div>

    <div id="customAlert" class="fixed inset-0 z-[90] hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4">
        <div class="bg-[#12171f] border border-orange-500/30 rounded-2xl p-6 max-w-sm w-full text-center shadow-2xl animate-modal">
            <div class="text-4xl mb-3">⚠️</div>
            <h3 class="text-lg font-black text-white mb-2">تنبيه النظام</h3>
            <p id="alertMessage" class="text-sm text-gray-300 mb-6 leading-relaxed">رسالة التنبيه هنا</p>
            <button onclick="closeModal('customAlert')" class="btn bg-orange-600 hover:bg-orange-500 text-white">حسناً، فهمت</button>
        </div>
    </div>

    <div id="customConfirm" class="fixed inset-0 z-[80] hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4">
        <div class="bg-[#12171f] border border-red-500/30 rounded-2xl p-6 max-w-sm w-full text-center shadow-2xl animate-modal">
            <div class="text-4xl mb-3">🛑</div>
            <h3 class="text-lg font-black text-white mb-2">تأكيد الرفض</h3>
            <p id="confirmMessage" class="text-sm text-gray-300 mb-6 leading-relaxed">هل أنت متأكد من رفض المتقدم؟</p>
            <div class="flex gap-3">
                <button onclick="closeModal('customConfirm')" class="btn bg-[#1a2029] text-gray-400 hover:text-white">إلغاء</button>
                <button onclick="executeReject()" id="finalRejectBtn" class="btn btn-reject">✖ نعم، ارفض المتقدم</button>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        const rawEncodedData = '<%- encodeURIComponent(JSON.stringify(applications || [])) %>';
        const applicantsData = JSON.parse(decodeURIComponent(rawEncodedData));
        
        let currentApp = null; 

        function filterCards() {
            const input = document.getElementById('searchInput').value.toLowerCase();
            const cards = document.querySelectorAll('.card-tactical');
            cards.forEach(card => {
                if (card.getAttribute('data-search') && card.getAttribute('data-search').toLowerCase().includes(input)) {
                    card.style.display = 'flex';
                } else { card.style.display = 'none'; }
            });
        }

        // فتح نافذة الاستعراض الرئيسية
        function openModal(id) {
            currentApp = applicantsData.find(a => String(a.id) === String(id));
            if (!currentApp) return;

            document.getElementById('modalName').innerText = currentApp.name;
            document.getElementById('modalId').innerText = "Copy ID: " + currentApp.id;
            
            const qaContainer = document.getElementById('modalQaGrid');
            qaContainer.innerHTML = "";

            if (currentApp.qaList && currentApp.qaList.length > 0) {
                currentApp.qaList.forEach((item, idx) => {
                    qaContainer.innerHTML += `
                        <div class="bg-[#0b0e12] p-4 rounded-2xl border border-[#1f2630] flex flex-col shadow-inner">
                            <span class="text-xs font-bold text-orange-400 mb-2 font-mono block">❓ السؤال [${idx + 1}]: ${item.question}</span>
                            <p class="text-sm text-gray-200 leading-relaxed bg-[#07090c] p-3 rounded-xl border border-white/5 whitespace-pre-wrap">${item.answer}</p>
                        </div>`;
                });
            }

            document.getElementById('applicantModal').classList.remove('hidden');
            document.getElementById('applicantModal').classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
            document.getElementById(modalId).classList.remove('flex');
            // نرجع السكرول للبودي فقط إذا قفلنا النافذة الرئيسية (عشان ما يعلق السكرول)
            if(modalId === 'applicantModal') document.body.style.overflow = 'auto';
        }

        function showAlert(msg) {
            document.getElementById('alertMessage').innerText = msg;
            document.getElementById('customAlert').classList.remove('hidden');
            document.getElementById('customAlert').classList.add('flex');
        }

        // فتح نافذة إكمال البيانات (الذكية)
        function promptAcceptData() {
            if (!currentApp) return;
            
            document.getElementById('fillNationalId').value = '';

            // فحص العمر: إذا كان يحتوي على أرقام (عربية أو إنجليزية) يعني متوفر
            const ageVal = currentApp.age ? String(currentApp.age).trim() : '';
            const hasValidAgeNumber = /\d|[\u0660-\u0669]/.test(ageVal);

            if (hasValidAgeNumber) {
                document.getElementById('ageContainer').style.display = 'none'; // نخفيه لأنه موجود
            } else {
                document.getElementById('ageContainer').style.display = 'block'; // نظهره لأنه ناقص
                document.getElementById('fillAge').value = '';
            }

            document.getElementById('fillDataModal').classList.remove('hidden');
            document.getElementById('fillDataModal').classList.add('flex');
        }

        // إرسال طلب القبول
        async function confirmAcceptSubmit() {
            const nationalId = document.getElementById('fillNationalId').value.trim();
            const ageContainerVisible = document.getElementById('ageContainer').style.display !== 'none';
            const ageInput = document.getElementById('fillAge').value.trim();

            if (!nationalId) {
                showAlert("عذراً، يجب تعبئة (الرقم الوطني) قبل الاعتماد!");
                return;
            }

            // إذا كانت خانة العمر ظاهرة (يعني ناقص)، تأكد إنه عباها
            let finalAge = currentApp.age;
            if (ageContainerVisible) {
                if (!ageInput) {
                    showAlert("عذراً، التقديم لا يحتوي على عمر، يجب كتابته يدوياً!");
                    return;
                }
                finalAge = ageInput; // ناخذ اللي كتبه بيده
            }

            const btn = document.getElementById('finalAcceptBtn');
            btn.innerText = "⏳ جاري الرفع..."; btn.disabled = true;

            try {
                const res = await fetch('/api/accept-raw', { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json' }, 
                    body: JSON.stringify({ 
                        id: currentApp.id, 
                        name: currentApp.name, 
                        answers: currentApp.answers,
                        discordId: currentApp.discordId, // يُرسل مخفي في الخلفية
                        nationalId: nationalId,
                        age: finalAge
                    }) 
                });
                const result = await res.json();
                if (result.success) location.reload(); 
                else { showAlert('⚠️ خطأ: ' + result.error); btn.disabled = false; btn.innerText = "✔ تأكيد واعتماد"; }
            } catch (error) { 
                showAlert('⚠️ تعذر الاتصال بالسيرفر.'); 
                btn.disabled = false; btn.innerText = "✔ تأكيد واعتماد";
            }
        }

        // فتح نافذة الرفض
        function promptReject() {
            document.getElementById('confirmMessage').innerText = `هل أنت متأكد من رفض المتقدم (${currentApp.name}) نهائياً؟`;
            document.getElementById('customConfirm').classList.remove('hidden');
            document.getElementById('customConfirm').classList.add('flex');
        }

        // إرسال الرفض
        async function executeReject() {
            const btn = document.getElementById('finalRejectBtn');
            btn.innerText = "⏳ جاري الرفض..."; btn.disabled = true;

            try {
                const res = await fetch('/api/reject-raw', { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json' }, 
                    body: JSON.stringify({ id: currentApp.id, name: currentApp.name, answers: currentApp.answers }) 
                });
                const result = await res.json();
                if (result.success) location.reload(); 
                else { showAlert('⚠️ خطأ: ' + result.error); btn.disabled = false; btn.innerText = "✖ نعم، ارفض المتقدم"; }
            } catch (error) { 
                showAlert('⚠️ تعذر الاتصال بالسيرفر.'); 
                btn.disabled = false; btn.innerText = "✖ نعم، ارفض المتقدم";
            }
        }
    </script>
</body>
</html>
</file>

<file path="views/partials/navbar.ejs">
<%- include('loader') %>
<header class="bg-[#0b0e12]/95 backdrop-blur-xl border-b border-[#1f2630] sticky top-0 z-50 shadow-[0_10px_30px_rgba(0,0,0,0.8)]">
    <!-- استخدام w-full مع px-8 لدفع العناصر لأقصى الأطراف -->
    <div class="w-full px-6 md:px-10 h-24 flex justify-between items-center">
        
        <!-- أقصى اليمين: الشعار واسم الكلية -->
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 flex items-center justify-center">
                <img src="/images/logo.png" alt="شعار الكلية" class="w-full h-full object-contain drop-shadow-[0_0_15px_rgba(249,115,22,0.4)] hover:scale-110 transition-transform duration-300">
            </div>
            <div>
                <h1 class="text-xl font-black tracking-wider text-white uppercase font-mono">الكلية العسكرية</h1>
                <p class="text-[11px] text-orange-400 font-bold tracking-widest uppercase">نظام إدارة القيادة والتدريب | شرطة جستس</p>
            </div>
        </div>

        <!-- الوسط: القائمة الملاحية (مع إضافة دليل الكلية) -->
        <nav class="hidden xl:flex items-center gap-1.5 bg-[#12171f]/80 p-1.5 rounded-2xl border border-[#222b38] backdrop-blur-md shadow-inner">
            <a href="/dashboard" class="px-5 py-2.5 rounded-xl text-xs font-bold transition-all duration-300 <%= currentPage === 'dashboard' ? 'bg-gradient-to-r from-orange-600 to-amber-600 text-white shadow-[0_0_15px_rgba(249,115,22,0.4)]' : 'text-gray-400 hover:text-white hover:bg-[#1a212c]' %>"> الرئيسية</a>
            <a href="/applications" class="px-5 py-2.5 rounded-xl text-xs font-bold transition-all duration-300 <%= currentPage === 'applications' ? 'bg-gradient-to-r from-orange-600 to-amber-600 text-white shadow-[0_0_15px_rgba(249,115,22,0.4)]' : 'text-gray-400 hover:text-white hover:bg-[#1a212c]' %>"> تقديمات الشرطة</a>
            <a href="/interviews" class="px-5 py-2.5 rounded-xl text-xs font-bold transition-all duration-300 <%= currentPage === 'interviews' ? 'bg-gradient-to-r from-orange-600 to-amber-600 text-white shadow-[0_0_15px_rgba(249,115,22,0.4)]' : 'text-gray-400 hover:text-white hover:bg-[#1a212c]' %>"> المقابلات</a>
            <a href="/preliminary" class="px-5 py-2.5 rounded-xl text-xs font-bold transition-all duration-300 <%= currentPage === 'preliminary' ? 'bg-gradient-to-r from-orange-600 to-amber-600 text-white shadow-[0_0_15px_rgba(249,115,22,0.4)]' : 'text-gray-400 hover:text-white hover:bg-[#1a212c]' %>"> المقبولين مبدئياً</a>
            <a href="/final" class="px-5 py-2.5 rounded-xl text-xs font-bold transition-all duration-300 <%= currentPage === 'final' ? 'bg-gradient-to-r from-orange-600 to-amber-600 text-white shadow-[0_0_15px_rgba(249,115,22,0.4)]' : 'text-gray-400 hover:text-white hover:bg-[#1a212c]' %>"> الرصد النهائي</a>
            <a href="/guide" class="px-5 py-2.5 rounded-xl text-xs font-bold transition-all duration-300 <%= currentPage === 'guide' ? 'bg-gradient-to-r from-blue-600 to-cyan-600 text-white shadow-[0_0_15px_rgba(37,99,235,0.4)]' : 'text-blue-400 hover:text-white hover:bg-[#1a212c]' %>"> دليل الكلية</a>
            <% if(user && user.permissions && user.permissions.canApproveReject) { %>
                <a href="/templates" class="px-5 py-2.5 rounded-xl text-xs font-bold transition-all duration-300 <%= currentPage === 'templates' ? 'bg-gradient-to-r from-indigo-600 to-purple-600 text-white shadow-[0_0_15px_rgba(79,70,229,0.4)]' : 'text-gray-400 hover:text-white hover:bg-[#1a212c]' %>">إدارة المراسلات</a>
            <% } %>
        </nav>

        <!-- أقصى اليسار: صورة الديسكورد، الاسم، وزر تسجيل الخروج -->
        <div class="flex items-center gap-4">
            <div class="text-left hidden sm:flex flex-col items-end">
                <div class="text-sm font-black text-white tracking-wide"><%= user.username %></div>
                <div class="text-[10px] text-emerald-400 font-mono font-bold tracking-wider">● عضو الكلية</div>
            </div>
            
            <!-- سحب صورة الديسكورد الخاصة باليوزر -->
            <% const avatarUrl = user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png` : 'https://cdn.discordapp.com/embed/avatars/0.png'; %>
            <img src="<%= avatarUrl %>" alt="صورة المستخدم" class="w-12 h-12 rounded-xl border-2 border-[#222b38] shadow-[0_0_15px_rgba(0,0,0,0.5)] object-cover bg-[#161b22]">
            
            <div class="h-8 w-px bg-[#222b38] mx-1"></div>
            
            <a href="/logout" title="تسجيل الخروج" class="w-12 h-12 rounded-xl bg-red-500/10 hover:bg-red-600 text-red-500 hover:text-white border border-red-500/20 flex items-center justify-center transition-all shadow-lg group">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 group-hover:rotate-12 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
            </a>
        </div>
    </div>
</header>
</file>

<file path="views/dashboard.ejs">
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>الرئيسية | الكلية العسكرية</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen flex flex-col bg-[#05070a] selection:bg-orange-500 selection:text-white font-sans">
    <%- include('partials/navbar') %>

    <main class="w-full max-w-[90rem] mx-auto px-6 py-12 flex-1">
        
        <!-- القسم التعريفي للمركز (تصميم فخم وكبير) -->
        <div class="relative rounded-[2.5rem] bg-[#0d1117] border border-[#1f2630] p-10 md:p-16 mb-12 shadow-2xl overflow-hidden">
            <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-[#161b22] to-transparent opacity-50"></div>
            <div class="relative z-10">
                <span class="inline-block bg-orange-500/10 text-orange-500 border border-orange-500/20 text-xs font-mono font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-6">
                    CENTRAL COMMAND DASHBOARD
                </span>
                <h2 class="text-4xl md:text-5xl font-black text-white mb-4 leading-tight tracking-wide">
                    قيادة الاستقطاب العسكري - شرطة جستس
                </h2>
                <p class="text-base md:text-lg text-gray-400 max-w-3xl leading-relaxed">
                    نظام الكلية العسكرية التابعة لشرطة جستس المخصص لإدارة طلبات الالتحاق ورصد درجات التأهيل الميداني بدقة واحترافية عالية.
                </p>
            </div>
        </div>

        <!-- أرقام وإحصائيات المنظومة (كروت نظيفة وخفيفة) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-20">
            <div class="relative bg-[#0d1117] border border-[#1f2630] p-8 rounded-3xl overflow-hidden hover:border-gray-600 transition-colors">
                <div class="absolute right-0 top-0 w-1.5 h-full bg-gray-600"></div>
                <span class="text-sm text-gray-500 font-bold block mb-3 uppercase tracking-wider">إجمالي المتقدمين</span>
                <span class="text-5xl font-black text-white font-mono tracking-tighter"><%= stats.totalCount %></span>
            </div>
            
            <div class="relative bg-[#0d1117] border border-[#1f2630] p-8 rounded-3xl overflow-hidden hover:border-teal-500/50 transition-colors">
                <div class="absolute right-0 top-0 w-1.5 h-full bg-teal-500/70"></div>
                <span class="text-sm text-gray-500 font-bold block mb-3 uppercase tracking-wider">ميدان التدريب الحالي</span>
                <span class="text-5xl font-black text-teal-400 font-mono tracking-tighter"><%= stats.prelimCount %></span>
            </div>
            
            <div class="relative bg-[#0d1117] border border-[#1f2630] p-8 rounded-3xl overflow-hidden hover:border-emerald-500/50 transition-colors">
                <div class="absolute right-0 top-0 w-1.5 h-full bg-emerald-500/70"></div>
                <span class="text-sm text-gray-500 font-bold block mb-3 uppercase tracking-wider">المجتازين للدورة</span>
                <span class="text-5xl font-black text-emerald-400 font-mono tracking-tighter"><%= stats.passedCount %></span>
            </div>
            
            <div class="relative bg-[#0d1117] border border-[#1f2630] p-8 rounded-3xl overflow-hidden hover:border-red-500/50 transition-colors">
                <div class="absolute right-0 top-0 w-1.5 h-full bg-red-500/70"></div>
                <span class="text-sm text-gray-500 font-bold block mb-3 uppercase tracking-wider">الملفات المرفوضة</span>
                <span class="text-5xl font-black text-red-400 font-mono tracking-tighter"><%= stats.failedCount %></span>
            </div>
        </div>

        <!-- الهيكل القيادي للمنظومة -->
        <div class="mb-24">
            <div class="flex items-center gap-4 mb-10">
                <h3 class="text-2xl font-black text-white uppercase tracking-widest">الهيكل الاداري للكلية العسكرية</h3>
                <div class="flex-1 h-px bg-gradient-to-l from-[#1f2630] to-transparent"></div>
            </div>
            
            <!-- مسؤول الكلية (مستوى القيادة الأعلى) -->
            <div class="max-w-3xl mx-auto bg-[#0d1117] border border-amber-500/30 rounded-[2rem] p-10 text-center relative shadow-[0_0_40px_rgba(245,158,11,0.05)] mb-10">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-1/3 h-1.5 bg-amber-500 rounded-b-md"></div>
                <h4 class="text-4xl font-black text-white mb-3 tracking-wide">بيدرو الشمري</h4>
                <p class="text-base text-amber-500 font-bold uppercase tracking-widest mb-6">مسؤول الكلية العسكرية</p>
                <div class="text-sm text-gray-400 font-mono bg-[#161b22] px-6 py-3 rounded-xl border border-[#222b38] inline-block">
                    الإشراف العام والاعتماد المباشر لكافة القرارات التنظيمية
                </div>
            </div>

            <!-- المساعدين والمشرفين (مستوى القيادة الإشرافي) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- نائب المسؤول -->
                <div class="bg-[#0d1117] border border-[#1f2630] rounded-[2rem] p-8 text-center hover:bg-[#121820] transition-all relative overflow-hidden group">
                    <div class="absolute bottom-0 left-0 w-full h-1 bg-blue-500/30 group-hover:bg-blue-500/60 transition-colors"></div>
                    <h4 class="text-2xl font-black text-white mb-2">جو ريستوفا</h4>
                    <p class="text-sm text-blue-400 font-bold mb-5 tracking-wide">نائب مسؤول الكلية ومسؤول العمليات</p>
                    <div class="text-xs text-gray-400 font-mono leading-relaxed bg-[#05070a] p-4 rounded-xl border border-[#1f2630]">
                        نائب المسؤول ومسؤول تدريب العمليات وأعضاء تدريب العمليات ومسؤول الرصد والتقييم النهائي للعمليات.
                    </div>
                </div>

                <!-- مشرف التدريب والتفاوض -->
                <div class="bg-[#0d1117] border border-[#1f2630] rounded-[2rem] p-8 text-center hover:bg-[#121820] transition-all relative overflow-hidden group">
                    <div class="absolute bottom-0 left-0 w-full h-1 bg-emerald-500/30 group-hover:bg-emerald-500/60 transition-colors"></div>
                    <h4 class="text-2xl font-black text-white mb-2">عبدالعزيز الحربي</h4>
                    <p class="text-sm text-emerald-400 font-bold mb-5 tracking-wide">مشرف التدريب ومسؤول الأنظمة والتفاوض</p>
                    <div class="text-xs text-gray-400 font-mono leading-relaxed bg-[#05070a] p-4 rounded-xl border border-[#1f2630]">
                        مشرف تدريب الكلية لكل الاختبارات الميدانية ومسؤول تدريب التفاوض وأعضاء تدريب التفاوض ومسؤول عن رصد وتقييم مهارات التفاوض والتعامل مع المواقف الحرجة.
                    </div>
                </div>

                <!-- مشرف التدريب والاستيقافات -->
                <div class="bg-[#0d1117] border border-[#1f2630] rounded-[2rem] p-8 text-center hover:bg-[#121820] transition-all relative overflow-hidden group">
                    <div class="absolute bottom-0 left-0 w-full h-1 bg-teal-500/30 group-hover:bg-teal-500/60 transition-colors"></div>
                    <h4 class="text-2xl font-black text-white mb-2">بهاء خالد</h4>
                    <p class="text-sm text-teal-400 font-bold mb-5 tracking-wide">مشرف التدريب ومسؤول الاستيقافات</p>
                    <div class="text-xs text-gray-400 font-mono leading-relaxed bg-[#05070a] p-4 rounded-xl border border-[#1f2630]">
                        مشرف تدريب الكلية لكل الاختبارات الميدانية ومسؤول تدريب الاستيقافات وأعضاء تدريب الاستيقافات ومسؤول عن رصد وتقييم مهارات الاستيقافات المرورية، الجنائية، الإجبارية.
                    </div>
                </div>
            </div>
        </div>

        <!-- سجل أعضاء وهيئة تدريب الكلية (التصميم الجديد للكروت) -->
        <div>
            <div class="flex items-center gap-4 mb-8">
                <h3 class="text-2xl font-black text-white uppercase tracking-widest">سجل أعضاء وهيئة تدريب الكلية</h3>
                <div class="flex-1 h-px bg-gradient-to-l from-[#1f2630] to-transparent"></div>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <% if(typeof trainers !== 'undefined' && trainers.length > 0) { %>
                    <% trainers.forEach(trainer => { %>
                        <!-- كرت تعريف المدرب الجديد -->
                        <div class="relative bg-[#0d1117] border border-[#1f2630] rounded-2xl p-6 hover:bg-[#121820] hover:border-gray-600 transition-all group overflow-hidden flex flex-col justify-between min-h-[160px]">
                            <div class="absolute right-0 top-0 w-1 h-full bg-gray-700 group-hover:bg-gray-400 transition-colors"></div>
                            
                            <div class="mb-4">
                                <h5 class="text-xl font-black text-white mb-1 truncate tracking-wide"><%= trainer.name %></h5>
                                <p class="text-xs font-bold text-gray-500 tracking-wider uppercase"><%= trainer.role %></p>
                            </div>
                            
                            <div class="bg-[#05070a] border border-[#222b38] rounded-xl p-3 text-xs text-gray-400 font-mono leading-relaxed">
                                <%= trainer.duty %>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-full bg-[#0d1117] border border-dashed border-[#222b38] rounded-3xl p-12 text-center text-gray-500">
                        <p class="text-base font-bold font-mono tracking-widest uppercase">لا توجد أسماء مسجلة في كادر التدريب حالياً</p>
                    </div>
                <% } %>
            </div>
        </div>

    </main>

    <%- include('partials/footer') %>
</body>
</html>
</file>

<file path="views/templates.ejs">
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>مركز المراسلات | الكلية العسكرية</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
    <!-- مكتبة التنبيهات الفخمة SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .swal2-popup { background: #0e1218 !important; border: 1px solid #222b38 !important; border-radius: 1.5rem !important; color: #fff !important; }
        .swal2-title { color: #fff !important; }
        .swal2-html-container { color: #9ca3af !important; }
        .template-card { transition: transform 0.3s ease, box-shadow 0.3s ease; }
        .template-card:hover { transform: translateY(-3px); box-shadow: 0 10px 25px -5px rgba(0,0,0,0.4); }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-[#05070a] selection:bg-indigo-500 selection:text-white font-sans">
    <%- include('partials/navbar') %>

    <main class="max-w-[90rem] mx-auto px-6 py-12 flex-1 w-full">
        
        <!-- الهيدر الفخم -->
        <div class="relative rounded-[2.5rem] bg-[#0d1117] border border-[#1f2630] p-10 md:p-12 mb-12 shadow-2xl overflow-hidden">
            <div class="absolute top-0 left-0 w-1/3 h-full bg-gradient-to-r from-indigo-900/20 to-transparent opacity-50"></div>
            <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                <div>
                    <span class="inline-block bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 text-xs font-mono font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-4">
                        COMMUNICATIONS CENTER
                    </span>
                    <h2 class="text-3xl md:text-4xl font-black text-white mb-2 tracking-wide">مركز المراسلات والتوجيه</h2>
                    <p class="text-sm text-gray-400 max-w-2xl leading-relaxed">
                        قم بإدارة النماذج التلقائية للقبول والرفض، أو إرسال توجيهات عامة (Broadcast) لأي دفعة بضغطة زر.
                    </p>
                </div>
                <div class="text-6xl opacity-80 drop-shadow-[0_0_15px_rgba(79,70,229,0.3)]">📡</div>
            </div>
        </div>

        <!-- قسم قوالب القبول -->
        <div class="mb-12">
            <div class="flex items-center gap-3 mb-6">
                <span class="text-2xl">📥</span>
                <h3 class="text-2xl font-black text-white">نماذج الاعتماد والقبول</h3>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                
                <!-- قالب المقابلة -->
                <div class="template-card bg-[#0a0d12] border border-[#1f2630] rounded-2xl p-6 relative">
                    <div class="absolute top-0 right-0 w-full h-1 bg-orange-500 rounded-t-2xl"></div>
                    <label class="text-sm font-bold text-orange-400 mb-3 block">1. نموذج قبول المقابلة:</label>
                    <textarea id="tpl-interview" class="w-full h-28 bg-[#0d1117] border border-[#222b38] rounded-xl p-3 text-sm text-gray-300 font-mono resize-none focus:border-orange-500" placeholder="مثال: يرجى التوجه للانتظار غداً الساعة 9 م..."><%= templates.interview %></textarea>
                    <button onclick="saveTemp('interview', 'tpl-interview', '#f97316')" class="btn bg-[#161b22] hover:bg-orange-600 border border-[#222b38] text-white w-full mt-4 !py-2.5 text-xs font-bold">💾 حفظ قالب المقابلة</button>
                </div>

                <!-- قالب الميدان -->
                <div class="template-card bg-[#0a0d12] border border-[#1f2630] rounded-2xl p-6 relative">
                    <div class="absolute top-0 right-0 w-full h-1 bg-emerald-500 rounded-t-2xl"></div>
                    <label class="text-sm font-bold text-emerald-400 mb-3 block">2. نموذج القبول للميدان:</label>
                    <textarea id="tpl-preliminary" class="w-full h-28 bg-[#0d1117] border border-[#222b38] rounded-xl p-3 text-sm text-gray-300 font-mono resize-none focus:border-emerald-500" placeholder="مثال: يرجى لبس الزي الرياضي والتواجد في الميدان..."><%= templates.preliminary %></textarea>
                    <button onclick="saveTemp('preliminary', 'tpl-preliminary', '#10b981')" class="btn bg-[#161b22] hover:bg-emerald-600 border border-[#222b38] text-white w-full mt-4 !py-2.5 text-xs font-bold">💾 حفظ قالب الميدان</button>
                </div>

                <!-- قالب التخرج -->
                <div class="template-card bg-[#0a0d12] border border-[#1f2630] rounded-2xl p-6 relative">
                    <div class="absolute top-0 right-0 w-full h-1 bg-blue-500 rounded-t-2xl"></div>
                    <label class="text-sm font-bold text-blue-400 mb-3 block">3. نموذج التخرج (النهائي):</label>
                    <textarea id="tpl-final" class="w-full h-28 bg-[#0d1117] border border-[#222b38] rounded-xl p-3 text-sm text-gray-300 font-mono resize-none focus:border-blue-500" placeholder="مثال: نبارك لك اجتياز الأكاديمية بنجاح..."><%= templates.final %></textarea>
                    <button onclick="saveTemp('final', 'tpl-final', '#3b82f6')" class="btn bg-[#161b22] hover:bg-blue-600 border border-[#222b38] text-white w-full mt-4 !py-2.5 text-xs font-bold">💾 حفظ قالب التخرج</button>
                </div>

            </div>
        </div>

        <!-- قسم قوالب الرفض -->
        <div class="mb-12">
            <div class="flex items-center gap-3 mb-6">
                <span class="text-2xl">🚫</span>
                <h3 class="text-2xl font-black text-white">نماذج الرفض وطي القيد</h3>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                
                <!-- رفض المقابلة -->
                <div class="template-card bg-[#0a0d12] border border-[#1f2630] rounded-2xl p-6 relative">
                    <div class="absolute top-0 right-0 w-full h-1 bg-red-500 rounded-t-2xl"></div>
                    <label class="text-sm font-bold text-red-400 mb-3 block">نموذج السقوط في المقابلة:</label>
                    <textarea id="tpl-reject-interview" class="w-full h-24 bg-[#0d1117] border border-[#222b38] rounded-xl p-3 text-sm text-gray-300 font-mono resize-none focus:border-red-500" placeholder="مثال: نعتذر منك لعدم اجتيازك المقابلة الشخصية..."><%= templates.reject_interview || 'نعتذر منك، لم تجتز المقابلة الشخصية.' %></textarea>
                    <button onclick="saveTemp('reject_interview', 'tpl-reject-interview', '#ef4444')" class="btn bg-[#161b22] hover:bg-red-600 border border-[#222b38] text-white w-full mt-4 !py-2.5 text-xs font-bold">💾 حفظ رسالة رفض المقابلة</button>
                </div>

                <!-- طي القيد النهائي -->
                <div class="template-card bg-[#0a0d12] border border-[#1f2630] rounded-2xl p-6 relative">
                    <div class="absolute top-0 right-0 w-full h-1 bg-rose-700 rounded-t-2xl"></div>
                    <label class="text-sm font-bold text-rose-400 mb-3 block">نموذج طي القيد (الرسوب في الأكاديمية):</label>
                    <textarea id="tpl-reject-final" class="w-full h-24 bg-[#0d1117] border border-[#222b38] rounded-xl p-3 text-sm text-gray-300 font-mono resize-none focus:border-rose-500" placeholder="مثال: يؤسفنا إعلامك بطي قيدك لعدم اجتياز الميدان..."><%= templates.reject_final || 'نعتذر منك، لم تجتز دورة الأكاديمية العسكرية بنجاح.' %></textarea>
                    <button onclick="saveTemp('reject_final', 'tpl-reject-final', '#be123c')" class="btn bg-[#161b22] hover:bg-rose-700 border border-[#222b38] text-white w-full mt-4 !py-2.5 text-xs font-bold">💾 حفظ رسالة طي القيد</button>
                </div>

            </div>
        </div>

        <!-- القسم الثالث: البث العام (Broadcast) -->
        <div class="bg-[#0a0d12] border border-[#1f2630] rounded-3xl p-8 lg:p-10 relative shadow-lg">
            <div class="flex items-center gap-4 mb-8 border-b border-[#1f2630] pb-4">
                <span class="text-3xl">📢</span>
                <div>
                    <h3 class="text-xl font-black text-white">نظام الإرسال العام (Broadcast)</h3>
                    <p class="text-xs text-gray-500 mt-1">أرسل توجيهات أو إعلانات لدفعة كاملة أو لأشخاص محددين بضغطة زر.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- إعدادات الفئة -->
                <div class="space-y-6">
                    <div>
                        <label class="text-sm font-bold text-gray-300 mb-2 block">1. اختر الفئة المستهدفة:</label>
                        <select id="targetGroup" onchange="toggleCustomInput()" class="w-full bg-[#0d1117] border border-[#222b38] rounded-xl p-3.5 text-sm text-white focus:border-indigo-500 outline-none shadow-inner cursor-pointer">
                            <option value="raw">📝 تقديمات الشرطة الجديدة (<%= rawApps.length %>)</option>
                            <option value="interview">🎙️ المرشحين للمقابلات (<%= interviewUsers.length %>)</option>
                            <option value="preliminary">🛡️ متدربين الميدان (<%= prelimUsers.length %>)</option>
                            <option value="final">👑 بانتظار الاعتماد النهائي (<%= finalUsers.length %>)</option>
                            <option value="custom">🎯 إرسال مخصص (للمرفوضين أو أشخاص محددين)</option>
                        </select>
                    </div>

                    <div id="customInputContainer" class="hidden animate-fade-in">
                        <label class="text-sm font-bold text-indigo-400 mb-2 block">الصق الأيديات (Copy IDs) كل آيدي في سطر:</label>
                        <textarea id="customCopyIds" class="w-full h-32 bg-[#12171f] border border-indigo-500/30 rounded-xl p-4 text-sm text-gray-300 font-mono resize-none focus:border-indigo-500 shadow-inner" placeholder="123456789012345678&#10;876543210987654321"></textarea>
                        <p class="text-[10px] text-gray-500 mt-2">سيقوم النظام بفلترة المسافات واستخراج الأيديات الصحيحة تلقائياً.</p>
                    </div>
                </div>

                <!-- نص الرسالة -->
                <div class="flex flex-col">
                    <label class="text-sm font-bold text-gray-300 mb-2 block">2. اكتب رسالة البث العام:</label>
                    <textarea id="broadcastMsg" class="w-full flex-1 min-h-[160px] bg-[#0d1117] border border-[#222b38] rounded-xl p-5 text-sm text-gray-200 font-mono resize-none focus:border-indigo-500 shadow-inner" placeholder="اكتب إعلانك أو توجيهك هنا..."></textarea>
                    
                    <button onclick="sendBroadcast()" class="btn !bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 w-full !py-4 shadow-[0_0_20px_rgba(79,70,229,0.4)] text-base font-black tracking-widest mt-6 transition-all transform hover:scale-[1.02]">
                        🚀 إرسال الرسالة الآن
                    </button>
                </div>
            </div>
        </div>

    </main>

    <%- include('partials/footer') %>

    <script>
        // تمرير الايديات من السيرفر بشكل آمن
        const groupData = {
            raw: JSON.parse('<%- JSON.stringify(rawApps.map(u => u.copyId)) %>'),
            interview: JSON.parse('<%- JSON.stringify(interviewUsers.map(u => u.copyId)) %>'),
            preliminary: JSON.parse('<%- JSON.stringify(prelimUsers.map(u => u.copyId)) %>'),
            final: JSON.parse('<%- JSON.stringify(finalUsers.map(u => u.copyId)) %>')
        };

        function toggleCustomInput() {
            const group = document.getElementById('targetGroup').value;
            const customContainer = document.getElementById('customInputContainer');
            if (group === 'custom') {
                customContainer.classList.remove('hidden');
            } else {
                customContainer.classList.add('hidden');
            }
        }

        async function saveTemp(type, textareaId, colorHex) {
            const msg = document.getElementById(textareaId).value.trim();
            
            Swal.fire({
                title: '⏳ جاري الحفظ...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const res = await fetch('/api/templates/save', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ type, message: msg })
                });
                
                if((await res.json()).success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'تم الحفظ!',
                        text: 'تم تحديث القالب التلقائي بنجاح.',
                        confirmButtonColor: colorHex,
                        timer: 2000,
                        showConfirmButton: false
                    });
                } else {
                    Swal.fire('خطأ', 'حدث مشكلة أثناء الحفظ', 'error');
                }
            } catch (err) { 
                Swal.fire('مشكلة في الاتصال', 'تعذر الاتصال بالسيرفر.', 'error');
            }
        }

        async function sendBroadcast() {
            const groupKey = document.getElementById('targetGroup').value;
            let copyIds = [];

            if (groupKey === 'custom') {
                const rawText = document.getElementById('customCopyIds').value;
                copyIds = rawText.split('\n').map(id => id.trim()).filter(id => id.length >= 17);
                if(copyIds.length === 0) {
                    return Swal.fire('تنبيه', "يرجى لصق 'Copy ID' واحد صحيح على الأقل!", 'warning');
                }
            } else {
                copyIds = groupData[groupKey];
            }

            const msg = document.getElementById('broadcastMsg').value.trim();

            if(!msg) return Swal.fire('تنبيه', "يرجى كتابة نص الرسالة أولاً!", 'warning');
            if(copyIds.length === 0) return Swal.fire('تنبيه', "لا يوجد أشخاص في هذه الفئة لإرسال الرسالة لهم!", 'warning');

            Swal.fire({
                title: 'تأكيد البث العام 🚀',
                text: `سيتم إرسال رسالة خاصة (DM) لعدد (${copyIds.length}) شخص. هل أنت متأكد؟`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#4f46e5',
                cancelButtonColor: '#374151',
                confirmButtonText: 'نعم، أرسل للجميع',
                cancelButtonText: 'إلغاء'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    
                    Swal.fire({
                        title: '⏳ جاري الإرسال...',
                        html: 'يرجى عدم إغلاق الصفحة لحين انتهاء البث.',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    try {
                        const res = await fetch('/api/templates/send', {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({ copyIds, message: msg })
                        });
                        const data = await res.json();
                        
                        if(data.success) {
                            let resultHtml = `
                                <div class="text-right space-y-2 mt-4">
                                    <p class="text-emerald-400 font-bold">✔ نجاح الإرسال: ${data.successCount} شخص</p>
                                    <p class="text-red-400 font-bold">✖ فشل الإرسال: ${data.failCount} شخص</p>
                                </div>
                            `;
                            
                            Swal.fire({
                                icon: 'success',
                                title: 'تم اكتمال البث! 📢',
                                html: resultHtml,
                                confirmButtonColor: '#4f46e5'
                            });
                            
                            document.getElementById('broadcastMsg').value = ''; 
                            if(groupKey === 'custom') document.getElementById('customCopyIds').value = '';
                        } else {
                            Swal.fire('خطأ', `⚠️ ${data.error}`, 'error');
                        }
                    } catch (err) { 
                        Swal.fire('خطأ', "⚠️ تعذر إرسال الرسائل.", 'error');
                    }
                }
            });
        }
    </script>
</body>
</html>
</file>

