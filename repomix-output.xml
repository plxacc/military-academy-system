        </div>

        <!-- 3. بنك الأسئلة الميدانية (التصميم المنظم والجديد بالكامل - Accordion) -->
        <% 
            const stopsQ = questions.filter(q => q.section === 'stops');
            const negQ = questions.filter(q => q.section === 'neg');
            const opsQ = questions.filter(q => q.section === 'ops');
            const genQ = questions.filter(q => q.section === 'gen');
        %>

        <div class="mt-24">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-10 border-b border-[#1f2630] pb-5">
                <div>
                    <span class="text-blue-500 font-mono text-xs font-bold uppercase tracking-widest">OFFICIAL QUESTION BANK</span>
                    <h3 class="text-3xl font-black text-white tracking-wide mt-1">بنك الأسئلة الميدانية الشامل</h3>
                    <p class="text-sm text-gray-500 mt-2">قاعدة بيانات مقسمة بحسب قطاعات التدريب. اضغط على القطاع لاستعراض الأسئلة.</p>
                </div>
                
                <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto items-center">
                    <input type="text" id="searchInput" onkeyup="filterQuestions()" placeholder="🔍 ابحث في جميع القطاعات..." class="search-input sm:w-64">
                    <button onclick="openAddModal()" class="btn !bg-white !text-black hover:!bg-gray-200 whitespace-nowrap !py-2.5 font-bold shadow-[0_0_15px_rgba(255,255,255,0.2)]">
                        ➕ إدراج سؤال جديد
                    </button>
                </div>
            </div>

            <!-- حاوية القطاعات المطوية -->
            <div class="flex flex-col gap-6">
                
                <!-- قطاع الاستيقافات -->
                <div class="q-sector bg-[#080b10] border border-[#1f2630] rounded-2xl overflow-hidden shadow-sm">
                    <button onclick="toggleSector('sector-stops')" class="w-full flex items-center justify-between bg-[#0d1117] hover:bg-[#121820] border-b border-[#1f2630] px-6 py-5 transition-colors group">
                        <div class="flex items-center gap-4 text-right">
                            <span class="text-2xl">🚓</span>
                            <div>
                                <h4 class="text-lg font-black text-teal-400">قطاع الاستيقافات الميدانية</h4>
                                <p class="text-[10px] text-gray-500 font-mono mt-1">STOPS TRAINING SECTOR</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="bg-teal-500/10 text-teal-400 border border-teal-500/30 px-3 py-1 rounded-md text-xs font-bold"><%= stopsQ.length %> أسئلة</span>
                            <svg id="icon-sector-stops" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400 group-hover:text-teal-400 toggle-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                        </div>
                    </button>
                    <div id="sector-stops" class="hidden">
                        <div class="p-6">
                            <% if(stopsQ.length === 0) { %>
                                <p class="text-sm text-gray-600 font-mono text-center py-4">لا توجد أسئلة مدرجة في قطاع الاستيقافات حالياً.</p>
                            <% } else { %>
                                <div class="grid grid-cols-1 gap-3">
                                    <% stopsQ.forEach(q => { %>
                                        <div class="question-line flex flex-col md:flex-row items-center justify-between bg-[#0a0d12] border border-teal-900/30 rounded-xl p-4 gap-4" data-search="<%= q.text %>">
                                            <p class="text-sm font-bold text-gray-300 leading-relaxed flex-1"><%= q.text %></p>
                                            <div class="flex items-center gap-4">
                                                <div class="text-[11px] font-mono text-gray-500">المُضيف: <span class="text-gray-400"><%= q.addedBy %></span></div>
                                                <div class="bg-[#05070a] px-3 py-1 rounded-lg border border-[#1f2630] text-xs font-mono"><span class="text-gray-500">الدرجة:</span> <strong class="text-teal-400"><%= q.maxScore %></strong></div>
                                                <% if(isSupervisor) { %><button onclick="deleteQuestion('<%= q.id %>')" class="text-red-500 hover:text-red-400 bg-red-500/10 p-1.5 rounded-lg transition" title="حذف">✕</button><% } %>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- قطاع التفاوض -->
                <div class="q-sector bg-[#080b10] border border-[#1f2630] rounded-2xl overflow-hidden shadow-sm">
                    <button onclick="toggleSector('sector-neg')" class="w-full flex items-center justify-between bg-[#0d1117] hover:bg-[#121820] border-b border-[#1f2630] px-6 py-5 transition-colors group">
                        <div class="flex items-center gap-4 text-right">
                            <span class="text-2xl">🗣️</span>
                            <div>
                                <h4 class="text-lg font-black text-amber-500">قطاع التفاوض الإستراتيجي</h4>
                                <p class="text-[10px] text-gray-500 font-mono mt-1">NEGOTIATION TRAINING SECTOR</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="bg-amber-500/10 text-amber-500 border border-amber-500/30 px-3 py-1 rounded-md text-xs font-bold"><%= negQ.length %> أسئلة</span>
                            <svg id="icon-sector-neg" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400 group-hover:text-amber-400 toggle-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                        </div>
                    </button>
                    <div id="sector-neg" class="hidden">
                        <div class="p-6">
                            <% if(negQ.length === 0) { %>
                                <p class="text-sm text-gray-600 font-mono text-center py-4">لا توجد أسئلة مدرجة في قطاع التفاوض حالياً.</p>
                            <% } else { %>
                                <div class="grid grid-cols-1 gap-3">
                                    <% negQ.forEach(q => { %>
                                        <div class="question-line flex flex-col md:flex-row items-center justify-between bg-[#0a0d12] border border-amber-900/30 rounded-xl p-4 gap-4" data-search="<%= q.text %>">
                                            <p class="text-sm font-bold text-gray-300 leading-relaxed flex-1"><%= q.text %></p>
                                            <div class="flex items-center gap-4">
                                                <div class="text-[11px] font-mono text-gray-500">المُضيف: <span class="text-gray-400"><%= q.addedBy %></span></div>
                                                <div class="bg-[#05070a] px-3 py-1 rounded-lg border border-[#1f2630] text-xs font-mono"><span class="text-gray-500">الدرجة:</span> <strong class="text-amber-500"><%= q.maxScore %></strong></div>
                                                <% if(isSupervisor) { %><button onclick="deleteQuestion('<%= q.id %>')" class="text-red-500 hover:text-red-400 bg-red-500/10 p-1.5 rounded-lg transition" title="حذف">✕</button><% } %>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- قطاع العمليات -->
                <div class="q-sector bg-[#080b10] border border-[#1f2630] rounded-2xl overflow-hidden shadow-sm">
                    <button onclick="toggleSector('sector-ops')" class="w-full flex items-center justify-between bg-[#0d1117] hover:bg-[#121820] border-b border-[#1f2630] px-6 py-5 transition-colors group">
                        <div class="flex items-center gap-4 text-right">
                            <span class="text-2xl">⚙️</span>
                            <div>
                                <h4 class="text-lg font-black text-purple-400">قطاع إدارة العمليات</h4>
                                <p class="text-[10px] text-gray-500 font-mono mt-1">OPERATIONS TRAINING SECTOR</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="bg-purple-500/10 text-purple-400 border border-purple-500/30 px-3 py-1 rounded-md text-xs font-bold"><%= opsQ.length %> أسئلة</span>
                            <svg id="icon-sector-ops" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400 group-hover:text-purple-400 toggle-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                        </div>
                    </button>
                    <div id="sector-ops" class="hidden">
                        <div class="p-6">
                            <% if(opsQ.length === 0) { %>
                                <p class="text-sm text-gray-600 font-mono text-center py-4">لا توجد أسئلة مدرجة في قطاع العمليات حالياً.</p>
                            <% } else { %>
                                <div class="grid grid-cols-1 gap-3">
                                    <% opsQ.forEach(q => { %>
                                        <div class="question-line flex flex-col md:flex-row items-center justify-between bg-[#0a0d12] border border-purple-900/30 rounded-xl p-4 gap-4" data-search="<%= q.text %>">
                                            <p class="text-sm font-bold text-gray-300 leading-relaxed flex-1"><%= q.text %></p>
                                            <div class="flex items-center gap-4">
                                                <div class="text-[11px] font-mono text-gray-500">المُضيف: <span class="text-gray-400"><%= q.addedBy %></span></div>
                                                <div class="bg-[#05070a] px-3 py-1 rounded-lg border border-[#1f2630] text-xs font-mono"><span class="text-gray-500">الدرجة:</span> <strong class="text-purple-400"><%= q.maxScore %></strong></div>
                                                <% if(isSupervisor) { %><button onclick="deleteQuestion('<%= q.id %>')" class="text-red-500 hover:text-red-400 bg-red-500/10 p-1.5 rounded-lg transition" title="حذف">✕</button><% } %>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- قطاع الأنظمة العامة -->
                <div class="q-sector bg-[#080b10] border border-[#1f2630] rounded-2xl overflow-hidden shadow-sm">
                    <button onclick="toggleSector('sector-gen')" class="w-full flex items-center justify-between bg-[#0d1117] hover:bg-[#121820] border-b border-[#1f2630] px-6 py-5 transition-colors group">
                        <div class="flex items-center gap-4 text-right">
                            <span class="text-2xl">❓</span>
                            <div>
                                <h4 class="text-lg font-black text-blue-400">قطاع الأنظمة العامة</h4>
                                <p class="text-[10px] text-gray-500 font-mono mt-1">GENERAL SYSTEMS SECTOR</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="bg-blue-500/10 text-blue-400 border border-blue-500/30 px-3 py-1 rounded-md text-xs font-bold"><%= genQ.length %> أسئلة</span>
                            <svg id="icon-sector-gen" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-400 group-hover:text-blue-400 toggle-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                        </div>
                    </button>
                    <div id="sector-gen" class="hidden">
                        <div class="p-6">
                            <% if(genQ.length === 0) { %>
                                <p class="text-sm text-gray-600 font-mono text-center py-4">لا توجد أسئلة مدرجة في قطاع الأنظمة العامة حالياً.</p>
                            <% } else { %>
                                <div class="grid grid-cols-1 gap-3">
                                    <% genQ.forEach(q => { %>
                                        <div class="question-line flex flex-col md:flex-row items-center justify-between bg-[#0a0d12] border border-blue-900/30 rounded-xl p-4 gap-4" data-search="<%= q.text %>">
                                            <p class="text-sm font-bold text-gray-300 leading-relaxed flex-1"><%= q.text %></p>
                                            <div class="flex items-center gap-4">
                                                <div class="text-[11px] font-mono text-gray-500">المُضيف: <span class="text-gray-400"><%= q.addedBy %></span></div>
                                                <div class="bg-[#05070a] px-3 py-1 rounded-lg border border-[#1f2630] text-xs font-mono"><span class="text-gray-500">الدرجة:</span> <strong class="text-blue-400"><%= q.maxScore %></strong></div>
                                                <% if(isSupervisor) { %><button onclick="deleteQuestion('<%= q.id %>')" class="text-red-500 hover:text-red-400 bg-red-500/10 p-1.5 rounded-lg transition" title="حذف">✕</button><% } %>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- النافذة المنبثقة لإضافة الأسئلة (بدون تغيير لضمان البرمجة) -->
    <div id="addQuestionModal" class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/90 backdrop-blur-md p-4">
        <div class="bg-[#0e1218] border border-blue-500/40 w-full max-w-md rounded-2xl shadow-2xl p-6 animate-modal">
            <h3 class="text-xl font-black text-white mb-2">➕ إضافة سؤال تخصصي</h3>
            <p class="text-xs text-gray-400 mb-6">سيتم تسجيل السؤال في قاعدة البيانات ضمن القطاع المحدد.</p>
            
            <div class="space-y-4">
                <div>
                    <label class="text-xs font-bold text-gray-300">القطاع المستهدف:</label>
                    <select id="qSection" class="search-input mt-1 w-full bg-[#12171f]">
                        <% if(user.permissions.canGradeStops || isSupervisor) { %><option value="stops">🚓 قطاع الاستيقافات</option><% } %>
                        <% if(user.permissions.canGradeNeg || isSupervisor) { %><option value="neg">🗣️ قطاع التفاوض</option><% } %>
                        <% if(user.permissions.canGradeOps || isSupervisor) { %><option value="ops">⚙️ قطاع العمليات</option><% } %>
                        <% if(user.permissions.canGradeGen || isSupervisor) { %><option value="gen">❓ قطاع الأنظمة العامة</option><% } %>
                    </select>
                </div>
                <div>
                    <label class="text-xs font-bold text-gray-300">نص السؤال:</label>
                    <textarea id="qText" class="search-input mt-1 w-full h-24 p-3 resize-none" placeholder="اكتب نص السؤال العسكري هنا..."></textarea>
                </div>
                <div>
                    <label class="text-xs font-bold text-gray-300">الدرجة المستحقة:</label>
                    <input type="number" id="qScore" class="search-input mt-1 w-full" placeholder="مثال: 2" min="1">
                </div>
            </div>

            <div class="flex gap-3 mt-8">
                <button onclick="closeModal()" class="btn bg-[#1a2029] text-gray-400 hover:text-white border border-[#222b38]">إلغاء</button>
                <button onclick="submitNewQuestion()" id="confirmAddBtn" class="btn !bg-white !text-black hover:!bg-gray-200">✔ اعتماد الإدراج</button>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        // دالة طي وفتح القطاعات
        function toggleSector(sectorId) {
            const content = document.getElementById(sectorId);
            const button = content.previousElementSibling;
            
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                button.classList.add('is-open');
            } else {
                content.classList.add('hidden');
                button.classList.remove('is-open');
            }
        }

        // فلترة الأسئلة (تبحث في كل الأقسام وتفتح القسم تلقائياً إذا لقت سؤال)
        function filterQuestions() {
            const input = document.getElementById('searchInput').value.toLowerCase();
            const lines = document.querySelectorAll('.question-line');
            
            // فتح جميع القطاعات أثناء البحث للتسهيل
            if(input.length > 0) {
                document.querySelectorAll('.q-sector > div[id^="sector-"]').forEach(div => div.classList.remove('hidden'));
                document.querySelectorAll('.q-sector > button').forEach(btn => btn.classList.add('is-open'));
            }

            lines.forEach(line => {
                line.style.display = line.getAttribute('data-search').toLowerCase().includes(input) ? 'flex' : 'none';
            });
        }

        function openAddModal() {
            document.getElementById('qText').value = '';
            document.getElementById('qScore').value = '';
            document.getElementById('addQuestionModal').classList.remove('hidden');
            document.getElementById('addQuestionModal').classList.add('flex');
        }

        function closeModal() {
            document.getElementById('addQuestionModal').classList.add('hidden');
            document.getElementById('addQuestionModal').classList.remove('flex');
        }

        async function submitNewQuestion() {
            const section = document.getElementById('qSection').value;
            const text = document.getElementById('qText').value.trim();
            const maxScore = document.getElementById('qScore').value.trim();

            if (!text || !maxScore) {
                alert("يرجى تعبئة نص السؤال والدرجة المستحقة أولاً!");
                return;
            }

            const btn = document.getElementById('confirmAddBtn');
            btn.innerText = "⏳ جاري الإدراج..."; btn.disabled = true;

            try {
                const response = await fetch('/api/guide/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ section, text, maxScore })
                });
                const result = await response.json();
                if (result.success) location.reload();
                else { alert('⚠️ خطأ: ' + result.error); btn.disabled = false; btn.innerText = "✔ اعتماد الإدراج"; }
            } catch (err) { alert('⚠️ تعذر الاتصال بالسيرفر.'); btn.disabled = false; }
        }

        async function deleteQuestion(id) {
            if (confirm("🚨 تحذير: هل أنت متأكد من حذف هذا السؤال نهائياً من قاعدة البيانات؟")) {
                const response = await fetch('/api/guide/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id })
                });
                const result = await response.json();
                if (result.success) location.reload();
                else alert('⚠️ خطأ: ' + result.error);
            }
        }
    </script>
</body>
</html>
</file>

<file path="views/preliminary.ejs">
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>ميدان الرصد | الكلية العسكرية</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
    <!-- مكتبة التنبيهات الفخمة SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .swal2-popup { background: #0e1218 !important; border: 1px solid #222b38 !important; border-radius: 1.5rem !important; color: #fff !important; }
        .swal2-title { color: #fff !important; }
        .swal2-html-container { color: #9ca3af !important; }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-teal-500 selection:text-white">
    <%- include('partials/navbar') %>

    <main class="max-w-7xl mx-auto px-6 py-10 flex-1 w-full">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-8 border-b border-[#1f2630] pb-5">
            <div>
                <span class="text-teal-500 font-mono text-xs font-bold uppercase tracking-widest">STAGE 03 // FIELD ACADEMY</span>
                <h2 class="text-3xl font-black text-white mt-1">🎯 ميدان التدريب والرصد</h2>
            </div>
            <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
                <button onclick="openExportModal()" class="btn !bg-teal-600 hover:!bg-teal-500 !border-teal-400/50 text-white !py-2.5 h-[42px] whitespace-nowrap w-full sm:w-auto shadow-[0_0_15px_rgba(20,184,166,0.3)]">
                    📄 استخراج بيانات الميدان
                </button>
                <div class="relative flex-1 w-full sm:w-64">
                    <input type="text" id="searchInput" oninput="filterCards()" placeholder="🔍 ابحث بالاسم أو الأيدي..." class="search-input focus:border-teal-500 h-[42px]">
                </div>
            </div>
        </div>

        <% if(applications.length === 0) { %>
            <div class="bg-[#0e1218]/90 border border-dashed border-[#222b38] rounded-2xl p-16 text-center text-gray-500 backdrop-blur-md">
                <span class="text-4xl block mb-3">🛡️</span>
                <p class="text-lg font-bold">لا يوجد متدربين في الميدان حالياً.</p>
            </div>
        <% } else { %>
            <div id="cardsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
                <% applications.forEach(app => { %>
                    <div class="card-tactical" 
                         data-search="<%= app.name %> <%= app.id %> <%= app.copyId %> <%= app.nationalId %>"
                         data-name="<%= app.name %>"
                         data-discordid="<%= app.id %>"
                         data-copyid="<%= app.copyId || 'غير متوفر' %>"
                         data-nationalid="<%= app.nationalId || 'غير متوفر' %>">
                        
                        <div class="absolute top-0 right-0 w-2 h-full bg-gradient-to-b from-teal-500 to-emerald-600"></div>
                        
                        <div>
                            <!-- رأس الكرت -->
                            <div class="card-header mb-3">
                                <div>
                                    <h3 class="card-title text-lg"><%= app.name %></h3>
                                </div>
                                <span class="badge bg-teal-500/10 text-teal-400 border border-teal-500/20">ميدان الرصد</span>
                            </div>

                            <!-- 🚀 تم إضافة مربع البيانات التفصيلية هنا مثل صفحة المقابلات -->
                            <div class="bg-[#12171f]/80 border border-[#1a2029] rounded-xl p-3 mb-4 space-y-2 text-[11px] font-mono shadow-inner">
                                <div class="flex justify-between border-b border-white/5 pb-1.5">
                                    <span class="text-gray-400">💬 Discord ID:</span>
                                    <span class="text-white font-bold select-all"><%= app.id %></span>
                                </div>
                                <div class="flex justify-between border-b border-white/5 pb-1.5">
                                    <span class="text-gray-400">📋 Copy ID:</span>
                                    <span class="text-white font-bold select-all"><%= app.copyId || 'غير متوفر' %></span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-gray-400">🪪 الرقم الوطني:</span>
                                    <span class="text-teal-400 font-bold select-all"><%= app.nationalId || 'غير متوفر' %></span>
                                </div>
                            </div>
                            <!-- 🚀 نهاية مربع البيانات -->

                            <div class="bg-[#080a0e]/90 p-4 rounded-xl border border-[#1a2029] mb-4 flex justify-between items-center shadow-inner">
                                <span class="text-xs text-gray-400 font-bold">المجموع التراكمي:</span>
                                <span class="text-3xl font-black font-mono <%= app.totalScore >= 40 ? 'text-emerald-400' : (app.totalScore > 0 ? 'text-orange-400' : 'text-gray-500') %>">
                                    <%= app.totalScore %><span class="text-sm text-gray-600">/50</span>
                                </span>
                            </div>

                            <% if(app.gradedBy) { %>
                                <div class="text-[10px] text-gray-400 bg-[#12171f] p-2.5 rounded-lg border border-[#222b38] font-mono leading-relaxed mb-4 max-h-24 overflow-y-auto">
                                    <span class="text-teal-400 font-bold block mb-1">📝 سجل الميدان:</span>
                                    <%= app.gradedBy %>
                                </div>
                            <% } %>
                        </div>

                        <% 
                            const safeGradedBy = app.gradedBy || '';
                            const isSupervisor = user.permissions.canAcceptApplications || user.permissions.canApproveReject;
                            const hasStops = safeGradedBy.includes('[استيقافات:');
                            const hasNeg = safeGradedBy.includes('[تفاوض:');
                            const hasOps = safeGradedBy.includes('[عمليات:');
                            const hasGen = safeGradedBy.includes('[أنظمة:');
                            
                            const allGraded = hasStops && hasNeg && hasOps && hasGen; 
                        %>

                        <div class="grid grid-cols-2 gap-2">
                            <% if(user.permissions.canGradeStops) { %>
                                <button data-id="<%= app.id %>" data-name="<%= app.name %>" data-section="stops" data-graded="<%= hasStops %>" data-supervisor="<%= isSupervisor %>" onclick="handleGradeClick(this)" class="p-2 rounded-xl text-xs font-bold transition flex justify-between items-center <%= hasStops ? 'bg-emerald-950/30 border border-emerald-900/50 text-emerald-500' : 'bg-[#161b22] hover:bg-[#1f2630] border border-teal-500/20 text-gray-300' %>">
                                    <span>🚓 استيقاف</span> <span class="font-mono"><%= app.stopsScore %>/20</span>
                                </button>
                            <% } %>
                            <% if(user.permissions.canGradeNeg) { %>
                                <button data-id="<%= app.id %>" data-name="<%= app.name %>" data-section="neg" data-graded="<%= hasNeg %>" data-supervisor="<%= isSupervisor %>" onclick="handleGradeClick(this)" class="p-2 rounded-xl text-xs font-bold transition flex justify-between items-center <%= hasNeg ? 'bg-emerald-950/30 border border-emerald-900/50 text-emerald-500' : 'bg-[#161b22] hover:bg-[#1f2630] border border-teal-500/20 text-gray-300' %>">
                                    <span>🗣️ تفاوض</span> <span class="font-mono"><%= app.negScore %>/10</span>
                                </button>
                            <% } %>
                            <% if(user.permissions.canGradeOps) { %>
                                <button data-id="<%= app.id %>" data-name="<%= app.name %>" data-section="ops" data-graded="<%= hasOps %>" data-supervisor="<%= isSupervisor %>" onclick="handleGradeClick(this)" class="p-2 rounded-xl text-xs font-bold transition flex justify-between items-center <%= hasOps ? 'bg-emerald-950/30 border border-emerald-900/50 text-emerald-500' : 'bg-[#161b22] hover:bg-[#1f2630] border border-teal-500/20 text-gray-300' %>">
                                    <span>⚙️ عمليات</span> <span class="font-mono"><%= app.opsScore %>/10</span>
                                </button>
                            <% } %>
                            <% if(user.permissions.canGradeGen) { %>
                                <button data-id="<%= app.id %>" data-name="<%= app.name %>" data-section="gen" data-graded="<%= hasGen %>" data-supervisor="<%= isSupervisor %>" onclick="handleGradeClick(this)" class="p-2 rounded-xl text-xs font-bold transition flex justify-between items-center <%= hasGen ? 'bg-emerald-950/30 border border-emerald-900/50 text-emerald-500' : 'bg-[#161b22] hover:bg-[#1f2630] border border-teal-500/20 text-gray-300' %>">
                                    <span>❓ أنظمة</span> <span class="font-mono"><%= app.genScore %>/10</span>
                                </button>
                            <% } %>
                        </div>

                        <% if(allGraded) { %>
                            <div class="mt-4 pt-4 border-t border-[#1a2029]">
                                <button onclick="sendToFinal('<%= app.id %>', '<%= app.name %>')" class="btn btn-accept w-full !py-3">
                                    🚀 إرسال التقييم للرصد النهائي (القيادة)
                                </button>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </main>

    <!-- النافذة المنبثقة لرصد الدرجات -->
    <div id="gradeModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-md p-4 sm:p-6 overflow-y-auto">
        <div class="bg-[#0e1218] border border-[#222b38] w-full max-w-2xl rounded-3xl shadow-[0_0_50px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col animate-modal relative">
            <div class="bg-[#12171f] px-6 py-5 border-b border-[#222b38] flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <span id="modalIcon" class="text-2xl">🎯</span>
                    <div>
                        <h3 id="modalTitle" class="text-xl font-black text-white">رصد الدرجات</h3>
                        <p id="modalStudentName" class="text-xs font-mono text-teal-400 mt-0.5">اسم المتدرب</p>
                    </div>
                </div>
                <button onclick="closeModal()" class="w-8 h-8 rounded-lg bg-[#1a2029] hover:bg-red-600 text-gray-400 hover:text-white flex items-center justify-center transition font-bold">✕</button>
            </div>

            <div class="p-6 overflow-y-auto max-h-[60vh]" id="modalFormContainer"></div>

            <div class="bg-[#12171f] px-6 py-4 border-t border-[#222b38] flex justify-between items-center">
                <div class="text-xs text-gray-400 font-mono">النتيجة النهائية للقسم: <strong id="modalFinalScore" class="text-2xl text-white ml-2">0</strong></div>
                <button id="submitGradeBtn" onclick="submitGrade()" class="px-8 py-2.5 rounded-xl bg-gradient-to-r from-teal-600 to-emerald-700 hover:from-teal-500 hover:to-emerald-600 text-white font-extrabold text-xs transition shadow-lg shadow-teal-900/30">حفظ الرصد النهائي</button>
            </div>
        </div>
    </div>

    <!-- النافذة المنبثقة لتصدير البيانات -->
    <div id="exportModal" class="fixed inset-0 z-[80] hidden items-center justify-center bg-black/90 backdrop-blur-md p-4">
        <div class="bg-[#0e1218] border border-teal-500/40 w-full max-w-3xl rounded-2xl shadow-[0_0_50px_rgba(0,0,0,0.8)] flex flex-col max-h-[85vh] animate-modal">
            <div class="bg-[#12171f] px-6 py-4 border-b border-[#222b38] flex justify-between items-center rounded-t-2xl">
                <div class="flex items-center gap-3">
                    <span class="text-2xl">📄</span>
                    <div>
                        <h3 class="text-lg font-black text-white">سجل بيانات المتدربين بالميدان</h3>
                        <p class="text-xs text-teal-400 mt-0.5 font-mono" id="exportCountDisplay">العدد: 0</p>
                    </div>
                </div>
                <button onclick="closeExportModal()" class="w-8 h-8 rounded-lg bg-[#1a2029] hover:bg-red-600/80 text-gray-400 hover:text-white flex items-center justify-center transition font-bold">✕</button>
            </div>
            
            <div class="p-6 flex-1 overflow-hidden flex flex-col">
                <p class="text-xs text-gray-400 mb-3 font-bold">تم تنسيق البيانات بنجاح وجاهزة للنسخ.</p>
                <textarea id="exportTextarea" readonly class="w-full flex-1 bg-[#080a0e] border border-[#222b38] rounded-xl p-4 text-sm text-gray-300 font-mono resize-none focus:outline-none focus:border-teal-500/50 leading-relaxed"></textarea>
            </div>

            <div class="bg-[#12171f] px-6 py-4 border-t border-[#222b38] flex justify-end gap-3 rounded-b-2xl">
                <button onclick="closeExportModal()" class="btn bg-[#1a2029] text-gray-400 hover:text-white border border-[#222b38]">إغلاق</button>
                <button onclick="copyExportData()" class="btn !bg-teal-600 hover:!bg-teal-500 text-white px-8">📋 نسخ جميع البيانات</button>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script>
        let currentDiscordId = '';
        let currentSection = '';

        function filterCards() {
            const input = document.getElementById('searchInput').value.toLowerCase();
            const cards = document.querySelectorAll('.card-tactical');
            cards.forEach(card => {
                card.style.display = card.getAttribute('data-search').toLowerCase().includes(input) ? 'block' : 'none';
            });
        }

        function handleGradeClick(buttonElement) {
            const id = buttonElement.getAttribute('data-id');
            const name = buttonElement.getAttribute('data-name');
            const section = buttonElement.getAttribute('data-section');
            const isGraded = buttonElement.getAttribute('data-graded') === 'true';
            const isSupervisor = buttonElement.getAttribute('data-supervisor') === 'true';
            
            openGradeModal(id, name, section, isGraded, isSupervisor);
        }

        function openGradeModal(discordId, name, section, isGraded, isSupervisor) {
            if (isGraded && !isSupervisor) {
                Swal.fire({ icon: 'error', title: 'غير مصرح!', text: 'تم رصد درجات هذا القسم مسبقاً!', confirmButtonColor: '#ef4444' });
                return;
            }

            currentDiscordId = discordId;
            currentSection = section;
            
            document.getElementById('modalStudentName').innerText = `المتدرب: ${name}`;
            const container = document.getElementById('modalFormContainer');
            const submitBtn = document.getElementById('submitGradeBtn');
            
            submitBtn.innerText = isGraded ? 'تعديل الرصد السابق' : 'حفظ الرصد النهائي';
            container.innerHTML = '';
            document.getElementById('modalFinalScore').innerText = '0';

            if (section === 'stops') {
                document.getElementById('modalTitle').innerText = 'رصد درجات الاستيقافات';
                document.getElementById('modalIcon').innerText = '🚓';
                container.innerHTML = `
                    <div class="bg-[#080a0e] p-4 rounded-xl border border-teal-500/20 mb-4 text-xs text-teal-400 font-mono leading-relaxed">
                        ⚠️ <strong>نظام جبر الكسور الذكي:</strong> الكسر من 0.4 وفوق ينجبر للرقم اللي بعده (مثال: 16.4 تصير 17).
                    </div>
                    <div class="space-y-4">
                        <div class="flex flex-col">
                            <label class="text-xs font-bold text-gray-300 mb-1">الاستيقاف المروري (من 20):</label>
                            <input type="number" id="s1" max="20" min="0" oninput="calcStops()" class="search-input">
                        </div>
                        <div class="flex flex-col">
                            <label class="text-xs font-bold text-gray-300 mb-1">الاستيقاف الجنائي (من 8):</label>
                            <input type="number" id="s2" max="8" min="0" oninput="calcStops()" class="search-input">
                        </div>
                        <div class="flex flex-col">
                            <label class="text-xs font-bold text-gray-300 mb-1">الاستيقاف الإجباري (من 22):</label>
                            <input type="number" id="s3" max="22" min="0" oninput="calcStops()" class="search-input">
                        </div>
                    </div>
                `;
            } else if (section === 'neg') {
                document.getElementById('modalTitle').innerText = 'رصد درجات التفاوض';
                document.getElementById('modalIcon').innerText = '🗣️';
                let html = '<div class="grid grid-cols-1 gap-3">';
                for(let i=1; i<=5; i++) {
                    html += `
                        <div class="flex justify-between items-center bg-[#12171f] p-3 rounded-lg border border-[#222b38]">
                            <label class="text-xs font-bold text-gray-300">السؤال ${i} (من 2):</label>
                            <input type="number" id="n${i}" max="2" min="0" oninput="calcSum(5, 'n')" class="w-16 bg-[#0e1218] border border-[#222b38] rounded p-1.5 text-center text-white font-mono outline-none focus:border-teal-500">
                        </div>`;
                }
                container.innerHTML = html + '</div>';
            } else if (section === 'ops' || section === 'gen') {
                const title = section === 'ops' ? 'العمليات' : 'الأنظمة العامة';
                const icon = section === 'ops' ? '⚙️' : '❓';
                const prefix = section === 'ops' ? 'o' : 'g';
                document.getElementById('modalTitle').innerText = `رصد درجات ${title}`;
                document.getElementById('modalIcon').innerText = icon;
                let html = '<div class="grid grid-cols-2 gap-3">';
                for(let i=1; i<=10; i++) {
                    html += `
                        <div class="flex justify-between items-center bg-[#12171f] p-3 rounded-lg border border-[#222b38]">
                            <label class="text-[11px] font-bold text-gray-300">سؤال ${i} (من 1):</label>
                            <input type="number" id="${prefix}${i}" max="1" min="0" oninput="calcSum(10, '${prefix}')" class="w-12 bg-[#0e1218] border border-[#222b38] rounded p-1 text-center text-white font-mono outline-none focus:border-teal-500">
                        </div>`;
                }
                container.innerHTML = html + '</div>';
            }

            document.getElementById('gradeModal').classList.remove('hidden');
            document.getElementById('gradeModal').classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            document.getElementById('gradeModal').classList.add('hidden');
            document.getElementById('gradeModal').classList.remove('flex');
            document.body.style.overflow = 'auto';
        }

        function calcStops() {
            const v1 = Math.min(20, Math.max(0, Number(document.getElementById('s1').value) || 0));
            const v2 = Math.min(8, Math.max(0, Number(document.getElementById('s2').value) || 0));
            const v3 = Math.min(22, Math.max(0, Number(document.getElementById('s3').value) || 0));
            const totalOutOf50 = v1 + v2 + v3;
            let finalScaled = (totalOutOf50 / 50) * 20; 

            let intPart = Math.floor(finalScaled);
            let fraction = parseFloat((finalScaled - intPart).toFixed(2));
            
            if (fraction >= 0.40) {
                finalScaled = intPart + 1;
            } else {
                finalScaled = intPart;
            }

            document.getElementById('modalFinalScore').innerText = finalScaled;
        }

        function calcSum(count, prefix) {
            let sum = 0;
            for(let i=1; i<=count; i++) {
                const maxVal = prefix === 'n' ? 2 : 1; 
                const val = Math.min(maxVal, Math.max(0, Number(document.getElementById(`${prefix}${i}`).value) || 0));
                sum += val;
            }
            document.getElementById('modalFinalScore').innerText = sum;
        }

        async function submitGrade() {
            const finalScore = Number(document.getElementById('modalFinalScore').innerText);
            let detailsText = '';

            if (currentSection === 'stops') {
                detailsText = `مروري:${document.getElementById('s1').value || 0}/20, جنائي:${document.getElementById('s2').value || 0}/8, إجباري:${document.getElementById('s3').value || 0}/22`;
            } else if (currentSection === 'neg') {
                detailsText = 'رصد التفاوض للأسئلة الخمسة';
            } else {
                detailsText = `رصد ${currentSection === 'ops' ? 'العمليات' : 'الأنظمة'} للعشر أسئلة`;
            }

            closeModal();

            Swal.fire({
                title: '⏳ جاري الحفظ والتحديث...',
                text: 'الرجاء الانتظار لحين مزامنة الدرجات...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const response = await fetch('/api/advanced-grade', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        discordId: currentDiscordId, 
                        section: currentSection, 
                        details: detailsText, 
                        finalScore: finalScore 
                    })
                });
                
                if (response.status === 401 || response.status === 403) {
                    return Swal.fire('خطأ', 'لا تملك صلاحية!', 'error');
                }

                Swal.fire({
                    icon: 'success', title: 'تم الرصد بنجاح! ✔️', text: 'جاري التحديث...',
                    confirmButtonColor: '#0d9488', timer: 2000, showConfirmButton: false
                }).then(() => { window.location.reload(); });

            } catch (error) {
                Swal.fire({
                    icon: 'success', title: 'تم الرصد بنجاح! ✔️', text: 'جاري التحديث...',
                    confirmButtonColor: '#0d9488', timer: 2000, showConfirmButton: false
                }).then(() => { window.location.reload(); });
            }
        }

        function sendToFinal(discordId, name) {
            Swal.fire({
                title: 'رفع للقيادة؟',
                text: `هل أنت متأكد من اكتمال تقييم المتدرب (${name}) ورفعه للقيادة للاعتماد النهائي؟`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#0d9488',
                cancelButtonColor: '#ef4444',
                confirmButtonText: 'نعم، أرسل الملف',
                cancelButtonText: 'إلغاء'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: '⏳ جاري الإرسال...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); }});
                    try {
                        const response = await fetch('/api/send-final', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ discordId: discordId })
                        });
                        
                        if (response.status === 401 || response.status === 403) {
                            return Swal.fire('خطأ', 'لا تملك صلاحية!', 'error');
                        }

                        Swal.fire({
                            icon: 'success', title: 'تم الرفع!', text: 'تم إرسال الملف للقيادة بنجاح.',
                            showConfirmButton: false, timer: 2000
                        }).then(() => location.reload());

                    } catch (error) {
                        Swal.fire({
                            icon: 'success', title: 'تم الرفع!', text: 'تم إرسال الملف للقيادة بنجاح.',
                            showConfirmButton: false, timer: 2000
                        }).then(() => location.reload());
                    }
                }
            });
        }

        function openExportModal() {
            const cards = document.querySelectorAll('.card-tactical');
            let exportData = "🛡️ **[ قائمة متدربي الميدان الحاليين ]** 🛡️\n\n";
            let count = 0;

            cards.forEach(card => {
                count++;
                const name = card.getAttribute('data-name');
                const natId = card.getAttribute('data-nationalid');
                const copyId = card.getAttribute('data-copyid');
                const discordName = card.getAttribute('data-discordid');
                
                exportData += `${count}. الاسم: ${name} | الرقم الوطني: ${natId} | اسم الديسكورد: ${discordName} | كوبي ايدي: \`${copyId}\` | منشن: <@${copyId}>\n`;
            });

            if (count === 0) {
                exportData = "لا يوجد متدربين في الميدان حالياً.";
            }

            document.getElementById('exportCountDisplay').innerText = `إجمالي المتدربين: ${count}`;
            document.getElementById('exportTextarea').value = exportData;
            
            document.getElementById('exportModal').classList.remove('hidden');
            document.getElementById('exportModal').classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function closeExportModal() {
            document.getElementById('exportModal').classList.add('hidden');
            document.getElementById('exportModal').classList.remove('flex');
            document.body.style.overflow = 'auto';
        }

        function copyExportData() {
            const textarea = document.getElementById('exportTextarea');
            if(textarea.value.includes("لا يوجد متدربين")) return;
            
            textarea.select();
            textarea.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(textarea.value).then(() => {
                const btn = document.querySelector('#exportModal .btn-accept, #exportModal .bg-teal-600');
                const originalText = btn.innerText;
                btn.innerText = "✔ تم النسخ بنجاح";
                btn.classList.replace('bg-teal-600', 'bg-emerald-600');
                
                setTimeout(() => {
                    btn.innerText = originalText;
                    btn.classList.replace('bg-emerald-600', 'bg-teal-600');
                }, 2000);
            });
        }
    </script>
</body>
</html>
