<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>مركز المراسلات | الكلية العسكرية</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .swal2-popup { background: #0e1218 !important; border: 1px solid #222b38 !important; border-radius: 1.5rem !important; color: #fff !important; }
        .swal2-title { color: #fff !important; }
        .swal2-html-container { color: #9ca3af !important; }
        .member-item:hover { background-color: rgba(79, 70, 229, 0.08); border-color: rgba(99, 102, 241, 0.4); }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-[#05070a] selection:bg-indigo-500 selection:text-white font-sans">
    <%- include('partials/navbar') %>

    <main class="max-w-[90rem] mx-auto px-6 py-12 flex-1 w-full">
        
        <!-- الهيدر -->
        <div class="relative rounded-[2.5rem] bg-[#0d1117] border border-[#1f2630] p-10 md:p-12 mb-10 shadow-2xl overflow-hidden">
            <div class="absolute top-0 left-0 w-1/3 h-full bg-gradient-to-r from-indigo-900/20 to-transparent opacity-50"></div>
            <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                <div>
                    <span class="inline-block bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 text-xs font-mono font-bold px-4 py-1.5 rounded-full uppercase tracking-widest mb-4">
                        POLICE BROADCAST DISPATCH
                    </span>
                    <h2 class="text-3xl md:text-4xl font-black text-white mb-2 tracking-wide">منظومة مراسلة منسوبي الشرطة</h2>
                    <p class="text-sm text-gray-400 max-w-2xl leading-relaxed">
                        سحب فوري للعساكر حاملي رتبة منسوبي الشرطة مع إمكانية تحديد المستلمين وإرسال التعاميم الخاصة مباشرة.
                    </p>
                </div>
                <button onclick="fetchPoliceMembers()" id="refreshBtn" class="btn !bg-[#161b22] hover:!bg-[#1f2630] !border-indigo-500/40 text-indigo-400 !py-3 !px-6 rounded-2xl flex items-center gap-3 font-bold text-sm shadow-lg transition-all">
                    <span>🔄</span> تحديث قائمة العساكر
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <!-- قائمة منسوبي الشرطة والتحديد -->
            <div class="lg:col-span-7 bg-[#0a0d12] border border-[#1f2630] rounded-3xl p-6 lg:p-8 flex flex-col shadow-xl">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 border-b border-[#1f2630] pb-4">
                    <div>
                        <h3 class="text-lg font-black text-white flex items-center gap-2">
                            <span>👮‍♂️</span> قائمة منسوبي الشرطة
                        </h3>
                        <p class="text-xs text-gray-500 mt-1 font-mono">
                            المحدد: <span id="selectedCount" class="text-indigo-400 font-bold">0</span> من إجمالي <span id="totalMembersCount" class="text-white font-bold">0</span>
                        </p>
                    </div>
                    <div class="flex items-center gap-2 w-full sm:w-auto">
                        <button onclick="selectAll(true)" class="px-3 py-1.5 bg-[#12171f] hover:bg-[#1a202c] border border-[#222b38] rounded-xl text-xs text-gray-300 font-bold transition">تحديد الكل</button>
                        <button onclick="selectAll(false)" class="px-3 py-1.5 bg-[#12171f] hover:bg-[#1a202c] border border-[#222b38] rounded-xl text-xs text-gray-400 hover:text-white font-bold transition">إلغاء التحديد</button>
                    </div>
                </div>

                <!-- شريط البحث السريع في الأسماء -->
                <div class="mb-4">
                    <input type="text" id="memberSearch" onkeyup="filterMembersList()" placeholder="🔍 ابحث بالاسم أو الآيدي..." class="search-input !rounded-xl !bg-[#0d1117] focus:border-indigo-500">
                </div>

                <!-- الحاوية القابلة للتمرير للأعضاء -->
                <div id="membersContainer" class="flex-1 max-h-[500px] overflow-y-auto space-y-2 pr-1">
                    <div class="p-12 text-center text-gray-500 font-mono text-sm">
                        ⏳ جاري سحب بيانات منسوبي الشرطة من السيرفر...
                    </div>
                </div>
            </div>

            <!-- محرر الرسالة وزر الإرسال -->
            <div class="lg:col-span-5 flex flex-col gap-6">
                <div class="bg-[#0a0d12] border border-[#1f2630] rounded-3xl p-6 lg:p-8 flex flex-col shadow-xl flex-1">
                    <div class="flex items-center gap-3 mb-6 border-b border-[#1f2630] pb-4">
                        <span class="text-2xl">✍️</span>
                        <div>
                            <h3 class="text-lg font-black text-white">نص الرسالة / التعميم</h3>
                            <p class="text-xs text-gray-500">سيتم إرسال الرسالة في الخاص (DM) لكل من تم تحديده.</p>
                        </div>
                    </div>

                    <div class="flex-1 flex flex-col">
                        <textarea id="broadcastMsg" class="w-full flex-1 min-h-[300px] bg-[#0d1117] border border-[#222b38] rounded-2xl p-5 text-sm text-gray-200 font-mono resize-none focus:border-indigo-500 outline-none leading-relaxed shadow-inner" placeholder="اكتب نص التعميم أو التوجيه هنا..."></textarea>
                        
                        <div class="mt-6">
                            <button onclick="sendBroadcast()" class="btn !bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 w-full !py-4 shadow-[0_0_25px_rgba(79,70,229,0.35)] text-base font-black tracking-widest rounded-2xl transition-all transform hover:scale-[1.01]">
                                🚀 إرسال للأعضاء المحددين
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </main>

    <%- include('partials/footer') %>

    <script>
        let membersData = [];

        document.addEventListener('DOMContentLoaded', () => {
            fetchPoliceMembers();
        });

        // جلب الأعضاء من الـ API
        async function fetchPoliceMembers() {
            const container = document.getElementById('membersContainer');
            const refreshBtn = document.getElementById('refreshBtn');
            
            refreshBtn.disabled = true;
            container.innerHTML = `<div class="p-12 text-center text-gray-500 font-mono text-sm">⏳ جاري الاتصال بديسكورد وسحب الأعضاء...</div>`;

            try {
                const res = await fetch('/api/police-members');
                const data = await res.json();

                if (data.success) {
                    membersData = data.members;
                    document.getElementById('totalMembersCount').innerText = membersData.length;
                    renderMembersList(membersData);
                } else {
                    container.innerHTML = `<div class="p-12 text-center text-red-400 font-mono text-sm">⚠️ خطأ: ${data.error}</div>`;
                }
            } catch (err) {
                container.innerHTML = `<div class="p-12 text-center text-red-400 font-mono text-sm">⚠️ تعذر الاتصال بالسيرفر.</div>`;
            } finally {
                refreshBtn.disabled = false;
            }
        }

        // بناء قائمة الأعضاء في الـ HTML
        function renderMembersList(list) {
            const container = document.getElementById('membersContainer');
            if (list.length === 0) {
                container.innerHTML = `<div class="p-12 text-center text-gray-500 font-mono text-sm">لا يوجد أعضاء يحملون هذه الرتبة حالياً.</div>`;
                updateSelectedCount();
                return;
            }

            let html = '';
            list.forEach(m => {
                html += `
                    <label class="member-item flex items-center justify-between p-3.5 bg-[#0d1117] border border-[#1a202c] rounded-2xl cursor-pointer transition select-none" data-search="${m.username.toLowerCase()} ${m.id}">
                        <div class="flex items-center gap-3 min-w-0">
                            <input type="checkbox" value="${m.id}" onchange="updateSelectedCount()" class="member-checkbox w-4 h-4 rounded border-[#222b38] bg-[#0a0d12] text-indigo-600 focus:ring-0 focus:ring-offset-0 cursor-pointer accent-indigo-600">
                            <img src="${m.avatar}" alt="" class="w-9 h-9 rounded-xl object-cover border border-[#222b38]">
                            <div class="truncate">
                                <div class="text-sm font-bold text-gray-200 truncate">${m.username}</div>
                                <div class="text-[10px] font-mono text-gray-500 select-all">${m.id}</div>
                            </div>
                        </div>
                        <span class="text-[11px] font-mono text-indigo-400/80 bg-indigo-500/10 px-2.5 py-1 rounded-lg border border-indigo-500/20 whitespace-nowrap">منسوبي الشرطة</span>
                    </label>
                `;
            });

            container.innerHTML = html;
            updateSelectedCount();
        }

        // البحث والتصفية الفورية في القائمة
        function filterMembersList() {
            const q = document.getElementById('memberSearch').value.toLowerCase().trim();
            const items = document.querySelectorAll('.member-item');
            items.forEach(item => {
                const searchData = item.getAttribute('data-search');
                item.style.display = searchData.includes(q) ? 'flex' : 'none';
            });
        }

        // تحديد / إلغاء تحديد الكل
        function selectAll(check) {
            const checkboxes = document.querySelectorAll('.member-checkbox');
            checkboxes.forEach(cb => {
                // نحدد فقط العناصر الظاهرة بعد البحث
                if (cb.closest('.member-item').style.display !== 'none') {
                    cb.checked = check;
                }
            });
            updateSelectedCount();
        }

        // تحديث عداد المحدد
        function updateSelectedCount() {
            const checked = document.querySelectorAll('.member-checkbox:checked').length;
            document.getElementById('selectedCount').innerText = checked;
        }

        // إرسال البث للـ Selected Copy IDs
        async function sendBroadcast() {
            const selectedBoxes = document.querySelectorAll('.member-checkbox:checked');
            const copyIds = Array.from(selectedBoxes).map(cb => cb.value);
            const msg = document.getElementById('broadcastMsg').value.trim();

            if (copyIds.length === 0) {
                return Swal.fire('تنبيه', "يرجى تحديد عسكري واحد على الأقل من القائمة!", 'warning');
            }

            if (!msg) {
                return Swal.fire('تنبيه', "يرجى كتابة نص الرسالة أولاً!", 'warning');
            }

            Swal.fire({
                title: 'تأكيد إرسال البث 🚀',
                text: `سيتم إرسال الرسالة إلى (${copyIds.length}) من منسوبي الشرطة في الخاص. هل أنت متأكد؟`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#4f46e5',
                cancelButtonColor: '#374151',
                confirmButtonText: 'نعم، أرسل الآن',
                cancelButtonText: 'إلغاء'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    
                    Swal.fire({
                        title: '⏳ جاري الإرسال المباشر...',
                        html: 'يرجى الانتظار وعدم إغلاق الصفحة لضمان وصول الرسائل للجميع...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    try {
                        const res = await fetch('/api/templates/send', {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({ copyIds, message: msg })
                        });
                        const data = await res.json();
                        
                        if (data.success) {
                            let failedText = (data.failList || []).map(f => `• <@${f.id}> (${f.reason})`).join('\n');
                            
                            let resultHtml = `
                                <div class="text-right space-y-3 mt-4 text-xs font-mono">
                                    <div class="p-3 bg-emerald-950/40 border border-emerald-500/30 rounded-xl text-emerald-400 font-bold">
                                        ✔ نجاح الإرسال: ${data.successCount} عسكري
                                    </div>
                                    <div class="p-3 bg-red-950/40 border border-red-500/30 rounded-xl text-red-400 font-bold">
                                        ✖ فشل الإرسال: ${data.failCount} عسكري
                                    </div>
                                    ${data.failCount > 0 ? `
                                        <div class="mt-3">
                                            <p class="text-gray-400 font-bold mb-1">المتعذر إرسالها لهم (الخاص مقفل):</p>
                                            <textarea readonly class="w-full h-28 bg-[#080a0e] border border-[#222b38] rounded-xl p-2 text-red-400 text-[11px] resize-none focus:outline-none">${failedText}</textarea>
                                        </div>
                                    ` : ''}
                                </div>
                            `;
                            
                            Swal.fire({
                                icon: 'success',
                                title: 'تم اكتمال الإرسال! 📢',
                                html: resultHtml,
                                confirmButtonColor: '#4f46e5',
                                confirmButtonText: 'حسناً، فهمت'
                            });
                            
                            document.getElementById('broadcastMsg').value = ''; 
                        } else {
                            Swal.fire('خطأ', `⚠️ ${data.error}`, 'error');
                        }
                    } catch (err) { 
                        Swal.fire('خطأ', "⚠️ تعذر إرسال الرسائل. تأكد من الاتصال.", 'error');
                    }
                }
            });
        }
    </script>
</body>
</html>