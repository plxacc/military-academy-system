<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title><%= isReviewer ? 'إدارة ومراجعة التقديمات' : 'بوابة التقديم' %> | الكلية العسكرية</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .swal2-popup { background: #0e1218 !important; border: 1px solid #222b38 !important; border-radius: 1.5rem !important; color: #fff !important; }
        .swal2-title { color: #fff !important; }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-[#05070a] text-gray-200 font-sans selection:bg-orange-500 selection:text-white">

    <header class="bg-[#0b0e12]/95 border-b border-[#1f2630] py-4 px-6 md:px-10 flex justify-between items-center sticky top-0 z-50">
        <div class="flex items-center gap-3">
            <img src="/images/logo.png" class="w-10 h-10 object-contain">
            <div>
                <h1 class="text-sm font-black text-white">الكلية العسكرية</h1>
                <p class="text-[10px] text-orange-400 font-mono"><%= isReviewer ? 'لوحة الفرز والمراجعة القيادية' : 'بوابة استقطاب الأفراد' %></p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <span class="text-xs font-bold text-gray-300"><%= user.username %></span>
            <% if(isReviewer) { %>
                <a href="/dashboard" class="text-xs text-indigo-400 bg-indigo-950/40 border border-indigo-900/50 px-3 py-1.5 rounded-lg font-bold">الرئيسية</a>
            <% } %>
            <a href="/logout" class="text-xs text-red-400 bg-red-950/40 border border-red-900/50 px-3 py-1.5 rounded-lg">خروج</a>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-10 flex-1 w-full">

        <% if (isReviewer) { %>
            <!-- 1. شاشة المراجعة لمسؤول ونائب الكلية -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-8 border-b border-[#1f2630] pb-5">
                <div>
                    <span class="text-orange-500 font-mono text-xs font-bold uppercase tracking-widest">COMMAND REVIEW PANEL</span>
                    <h2 class="text-3xl font-black text-white mt-1">فرز ومراجعة طلبات الالتحاق بالدورة التدريبية</h2>
                </div>
                <div class="flex items-center gap-3 w-full md:w-auto">
                    <input type="text" id="searchInput" onkeyup="filterCards()" placeholder="🔍 ابحث بالاسم أو ID..." class="search-input md:w-80">
                    <div class="bg-[#12171f] px-4 py-2.5 rounded-xl border border-[#222b38] text-xs font-bold whitespace-nowrap">
                        في الانتظار: <span id="countDisplay" class="text-orange-400 font-mono"><%= applications ? applications.length : 0 %></span>
                    </div>
                </div>
            </div>

            <div id="cardsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
                <% (applications || []).forEach(app => { %>
                    <div class="card-tactical group" data-search="<%= app.name %> <%= app.id %>">
                        <div class="absolute top-0 right-0 w-2 h-full bg-gradient-to-b from-orange-500 to-amber-600"></div>
                        <div>
                            <div class="card-header">
                                <div>
                                    <h3 class="card-title"><%= app.name %></h3>
                                    <span class="card-id">ID: <%= app.id %></span>
                                </div>
                                <span class="badge badge-new">طلب جديد</span>
                            </div>
                            <div class="my-4 text-xs font-mono bg-[#080a0e]/80 p-3 rounded-xl border border-[#1a2029]">
                                <div class="text-gray-400">💬 الديسكورد: <strong class="text-white truncate" dir="ltr"><%= app.discordId %></strong></div>
                            </div>
                        </div>
                        <div class="mt-4 pt-4 border-t border-[#1a2029]">
                            <button onclick="openModal('<%= app.id %>')" class="btn btn-view">👁️ فحص الإجابات والقرار</button>
                        </div>
                    </div>
                <% }) %>
            </div>

            <% if(reviewedApps && reviewedApps.length > 0) { %>
                <div class="pt-8 border-t-2 border-[#1f2630]">
                    <h3 class="text-xl font-black text-gray-300 mb-6">📁 سجل التقديمات المفروزة (<%= reviewedApps.length %>)</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 opacity-75 hover:opacity-100 transition-opacity">
                        <% reviewedApps.forEach(app => { %>
                            <div class="card-tactical !p-5" data-search="<%= app.name %> <%= app.id %> <%= app.copyId %>">
                                <div class="card-header mb-2">
                                    <div>
                                        <h3 class="card-title text-lg"><%= app.name %></h3>
                                        <span class="card-id">ID: <%= app.copyId || app.id %></span>
                                    </div>
                                    <span class="badge <%= app.status.includes('مقبول') ? 'badge-new !text-emerald-400 !border-emerald-500' : 'badge-rejected' %>">
                                        <%= app.status.includes('مقبول') ? '✔ مقبول للميدان' : '✖ مرفوض' %>
                                    </span>
                                </div>
                                <div class="mt-3 pt-3 border-t border-white/5 text-xs font-mono <%= app.status.includes('مقبول') ? 'text-emerald-400/90' : 'text-red-400/90' %>">
                                    📝 <%= app.gradedBy || '[تمت المراجعة]' %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% } %>

            <!-- نافذة استعراض إجابات المتقدم -->
            <div id="applicantModal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/80 backdrop-blur-md p-4 sm:p-6 overflow-y-auto">
                <div class="bg-[#0e1218] border border-[#222b38] w-full max-w-4xl rounded-3xl shadow-[0_0_50px_rgba(0,0,0,0.9)] overflow-hidden flex flex-col max-h-[90vh] animate-modal relative">
                    <div class="bg-[#12171f] px-6 py-5 border-b border-[#222b38] flex justify-between items-center sticky top-0 z-10">
                        <div class="flex items-center gap-3">
                            <span class="w-3 h-3 rounded-full bg-orange-500 animate-pulse"></span>
                            <div>
                                <h3 id="modalName" class="text-xl font-black text-white">اسم المتقدم</h3>
                                <p id="modalId" class="card-id">ID: 000000000</p>
                            </div>
                        </div>
                        <button onclick="closeModal('applicantModal')" class="w-10 h-10 rounded-xl bg-[#1a2029] hover:bg-red-600/80 text-gray-400 hover:text-white flex items-center justify-center transition font-bold">✕</button>
                    </div>
                    
                    <div class="p-6 overflow-y-auto flex-1 space-y-4">
                        <div id="modalQaGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
                    </div>

                    <div class="bg-[#12171f] px-6 py-4 border-t border-[#222b38] flex flex-col sm:flex-row gap-3 justify-end items-center sticky bottom-0 z-10">
                        <button id="btnRejectMain" onclick="promptReject()" class="btn btn-reject sm:w-auto px-8 py-2.5">✖ رفض التقديم</button>
                        <button id="btnAcceptMain" onclick="promptAcceptData()" class="btn btn-accept sm:w-auto px-10 py-2.5">✔ قبول مبدئي للميدان</button>
                    </div>
                </div>
            </div>

            <!-- نافذة تأكيد الرقم الوطني -->
            <div id="fillDataModal" class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/90 backdrop-blur-md p-4">
                <div class="bg-[#0e1218] border border-emerald-500/40 w-full max-w-md rounded-2xl shadow-2xl p-6 animate-modal">
                    <h3 class="text-xl font-black text-white mb-2">📝 اعتماد وقبول المرشح</h3>
                    <p class="text-xs text-gray-400 mb-6">يرجى التأكد من الرقم الوطني للمتقدم لنقله للميدان.</p>
                    
                    <div class="space-y-4">
                        <div>
                            <label class="text-xs font-bold text-gray-300">الرقم الوطني: <span class="text-red-500">*</span></label>
                            <input type="text" id="fillNationalId" class="search-input mt-1 w-full text-center font-bold tracking-widest text-emerald-400" placeholder="مثال: 0068746019">
                            <p id="nationalIdHint" class="text-[10px] text-gray-500 mt-2 font-mono hidden">💡 تم سحب الرقم تلقائياً من الإجابات.</p>
                        </div>
                    </div>

                    <div class="flex gap-3 mt-8">
                        <button onclick="closeModal('fillDataModal')" class="btn bg-[#1a2029] text-gray-400 hover:text-white border border-[#222b38]">إلغاء</button>
                        <button onclick="confirmAcceptSubmit()" class="btn btn-accept" id="finalAcceptBtn">✔ تأكيد ونقل للميدان</button>
                    </div>
                </div>
            </div>

        <% } else { %>
            <!-- 2. استمارة التقديم للعسكري -->
            <div class="max-w-3xl mx-auto">
                <div class="bg-[#0d1117] border border-[#1f2630] rounded-[2rem] p-8 md:p-10 mb-8 shadow-2xl relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-2 h-full bg-orange-500"></div>
                    <h2 class="text-2xl md:text-3xl font-black text-white mb-2">استمارة الالتحاق بالدورة التأهيلية</h2>
                    <p class="text-xs text-gray-400 leading-relaxed">
                        أهلاً بك <strong class="text-white"><%= user.username %></strong>. يرجى ملء النموذج بدقة. فور إرسال النموذج ستمنح رتبة <span class="text-orange-400 font-bold">[مرشح]</span> في السيرفر تلقائياً.
                    </p>
                </div>

                <form id="applyForm" onsubmit="submitForm(event)" class="space-y-6">
                    <div class="bg-[#0a0d12] border border-[#1f2630] rounded-2xl p-6 shadow-inner">
                        <label class="text-sm font-bold text-orange-400 block mb-2">الرقم الوطني داخل السيرفر: <span class="text-red-500">*</span></label>
                        <input type="text" id="nationalIdInput" required placeholder="مثال: 0068746019" class="search-input !bg-[#0d1117] !p-4 !text-base focus:border-orange-500 text-white font-mono">
                    </div>

                    <% (questions || []).forEach((q, idx) => { %>
                        <div class="bg-[#0a0d12] border border-[#1f2630] rounded-2xl p-6 shadow-inner space-y-3">
                            <label class="text-sm font-bold text-gray-200 block leading-relaxed">
                                <span class="text-orange-500 font-mono ml-1">[<%= idx + 1 %>]</span> <%= q.question %> <span class="text-red-500">*</span>
                            </label>
                            <textarea required data-question="<%= q.question %>" placeholder="<%= q.placeholder %>" class="question-answer w-full h-24 bg-[#0d1117] border border-[#222b38] rounded-xl p-4 text-sm text-gray-200 font-mono focus:border-orange-500 outline-none leading-relaxed resize-none"></textarea>
                        </div>
                    <% }) %>

                    <button type="submit" id="submitBtn" class="btn !bg-gradient-to-r from-orange-600 to-amber-600 hover:from-orange-500 hover:to-amber-500 w-full !py-4 text-base font-black tracking-widest rounded-2xl shadow-xl transition-all">
                        🚀 إرسال طلب التقديم
                    </button>
                </form>
            </div>
        <% } %>

    </main>

    <%- include('partials/footer') %>

    <script>
        const isReviewerMode = JSON.parse('<%- JSON.stringify(Boolean(isReviewer)) %>');
        let applicantsData = JSON.parse('<%- JSON.stringify(applications || []) %>');
        let currentApp = null;

        function filterCards() {
            const input = document.getElementById('searchInput').value.toLowerCase();
            const cards = document.querySelectorAll('.card-tactical');
            cards.forEach(card => {
                card.style.display = card.getAttribute('data-search').toLowerCase().includes(input) ? 'flex' : 'none';
            });
        }

        function openModal(id) {
            currentApp = applicantsData.find(a => String(a.id) === String(id));
            if (!currentApp) return;

            document.getElementById('modalName').innerText = currentApp.name;
            document.getElementById('modalId').innerText = "Copy ID: " + currentApp.id;
            
            const qaContainer = document.getElementById('modalQaGrid');
            qaContainer.innerHTML = "";

            if (currentApp.qaList && currentApp.qaList.length > 0) {
                currentApp.qaList.forEach((item, idx) => {
                    qaContainer.innerHTML += `
                        <div class="bg-[#0b0e12] p-4 rounded-2xl border border-[#1f2630] flex flex-col shadow-inner">
                            <span class="text-xs font-bold text-orange-400 mb-2 font-mono block">❓ السؤال [${idx + 1}]: ${item.question}</span>
                            <p class="text-sm text-gray-200 leading-relaxed bg-[#07090c] p-3 rounded-xl border border-white/5 whitespace-pre-wrap">${item.answer}</p>
                        </div>`;
                });
            }

            document.getElementById('applicantModal').classList.remove('hidden');
            document.getElementById('applicantModal').classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
            document.getElementById(modalId).classList.remove('flex');
            if(modalId === 'applicantModal') document.body.style.overflow = 'auto';
        }

        function promptAcceptData() {
            if (!currentApp) return;
            const natIdInput = document.getElementById('fillNationalId');
            const hint = document.getElementById('nationalIdHint');
            
            let extractedId = currentApp.nationalId && currentApp.nationalId !== 'غير متوفر' ? currentApp.nationalId : '';
            if (!extractedId && currentApp.qaList) {
                const idQuestion = currentApp.qaList.find(q => q.question.includes('الرقم الوطني'));
                if (idQuestion) {
                    const match = idQuestion.answer.match(/\d{4,15}/);
                    if (match) extractedId = match[0];
                }
            }
            
            natIdInput.value = extractedId || '';
            if (extractedId) hint.classList.remove('hidden');
            else hint.classList.add('hidden');

            document.getElementById('fillDataModal').classList.remove('hidden');
            document.getElementById('fillDataModal').classList.add('flex');
        }

        async function confirmAcceptSubmit() {
            const nationalId = document.getElementById('fillNationalId').value.trim();
            if (!nationalId) return Swal.fire('تنبيه', 'الرقم الوطني مطلوب!', 'warning');

            const btn = document.getElementById('finalAcceptBtn');
            btn.innerText = "⏳ جاري النقل..."; btn.disabled = true;

            try {
                const res = await fetch('/api/accept-training', { 
                    method: 'POST', 
                    headers: { 'Content-Type': 'application/json' }, 
                    body: JSON.stringify({ 
                        id: currentApp.id, 
                        name: currentApp.name, 
                        answers: currentApp.answers,
                        discordId: currentApp.discordId,
                        nationalId: nationalId
                    }) 
                });
                const result = await res.json();
                if (result.success) location.reload(); 
                else { Swal.fire('خطأ', result.error, 'error'); btn.disabled = false; }
            } catch (error) { 
                Swal.fire('خطأ', 'تعذر الاتصال بالسيرفر.', 'error');
                btn.disabled = false;
            }
        }

        function promptReject() {
            Swal.fire({
                title: 'تأكيد الرفض 🛑',
                text: `هل أنت متأكد من رفض طلب تدريب (${currentApp.name})؟`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#374151',
                confirmButtonText: 'نعم، ارفض',
                cancelButtonText: 'إلغاء'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    const res = await fetch('/api/reject-training', { 
                        method: 'POST', 
                        headers: { 'Content-Type': 'application/json' }, 
                        body: JSON.stringify({ id: currentApp.id, name: currentApp.name, answers: currentApp.answers }) 
                    });
                    const data = await res.json();
                    if (data.success) location.reload();
                    else Swal.fire('خطأ', data.error, 'error');
                }
            });
        }

        async function submitForm(e) {
            e.preventDefault();
            const nationalId = document.getElementById('nationalIdInput').value.trim();
            const textareas = document.querySelectorAll('.question-answer');
            const answers = [];

            textareas.forEach(t => {
                answers.push({
                    question: t.getAttribute('data-question'),
                    answer: t.value.trim()
                });
            });

            const btn = document.getElementById('submitBtn');
            btn.disabled = true;
            btn.innerText = "⏳ جاري إرسال الطلب ومنح الرتبة...";

            Swal.fire({
                title: '⏳ جاري الحفظ والتسجيل...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            try {
                const res = await fetch('/api/submit-application', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ nationalId, answers })
                });
                const data = await res.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'تم استلام تقديمك بنجاح! 🎖️',
                        text: 'تم منحك رتبة مرشح في السيرفر وسيتم مراجعة طلبك من قبل القيادة.',
                        confirmButtonColor: '#f97316',
                        confirmButtonText: 'حسناً'
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire('خطأ', `⚠️ ${data.error}`, 'error');
                    btn.disabled = false;
                    btn.innerText = "🚀 إرسال طلب التقديم";
                }
            } catch (err) {
                Swal.fire('خطأ', 'تعذر الاتصال بالسيرفر.', 'error');
                btn.disabled = false;
                btn.innerText = "🚀 إرسال طلب التقديم";
            }
        }
    </script>
</body>
</html>